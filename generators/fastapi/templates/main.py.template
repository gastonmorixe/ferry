HOSTING_ORG_PATTERNS = [
    re.compile(pattern, re.IGNORECASE)
    for pattern in (
        r"cloudflare", r"amazon", r"aws", r"google", r"microsoft", r"azure",
        r"digitalocean", r"hetzner", r"ovh", r"linode", r"oracle", r"akamai",
        r"vultr", r"fastly", r"cdn", r"hosting", r"datacenter", r"colo",
    )
]

MOBILE_ORG_PATTERNS = [
    re.compile(pattern, re.IGNORECASE)
    for pattern in (
        r"mobile", r"wireless", r"cell", r"telecom", r"telefonica", r"vodafone",
        r"orange", r"verizon", r"airtel", r"mtn", r"telstra", r"singtel",
    )
]

_country_meta: Optional[dict[str, dict[str, str]]] = None
_country_ranges: Optional[list[tuple[int, int, str]]] = None
_asn_ranges: Optional[list[tuple[int, int, str, str]]] = None
_datasets_ready = False
_dataset_refresh_lock = threading.Lock()
_dataset_refresh_started = False


def _is_private_ip(ip: str) -> bool:
    if not ip or ip in ("unknown", "::1", "127.0.0.1"):
        return True
    ip = re.sub(r"^::ffff:", "", ip)
    if ip.startswith("10.") or ip.startswith("192.168."):
        return True
    if ip.startswith("172."):
        parts = ip.split(".")
        if len(parts) >= 2:
            try:
                oct2 = int(parts[1])
                if 16 <= oct2 <= 31:
                    return True
            except ValueError:
                pass
    if ip.startswith("fc") or ip.startswith("fd"):
        return True
    return False


def _parse_csv_line(line: str) -> list[str]:
    out: list[str] = []
    current = ""
    in_quotes = False
    i = 0
    while i < len(line):
        ch = line[i]
        if ch == '"':
            if in_quotes and i + 1 < len(line) and line[i + 1] == '"':
                current += '"'
                i += 1
            else:
                in_quotes = not in_quotes
        elif ch == "," and not in_quotes:
            out.append(current)
            current = ""
        else:
            current += ch
        i += 1
    out.append(current)
    return out


def _ipv4_to_number(ip: str) -> Optional[int]:
    normalized = re.sub(r"^::ffff:", "", ip)
    if not re.match(r"^\d+\.\d+\.\d+\.\d+$", normalized):
        return None
    values: list[int] = []
    for part in normalized.split("."):
        try:
            value = int(part)
        except ValueError:
            return None
        if value < 0 or value > 255:
            return None
        values.append(value)
    return (((values[0] * 256 + values[1]) * 256 + values[2]) * 256 + values[3]) & 0xFFFFFFFF


def _load_country_meta() -> dict[str, dict[str, str]]:
    global _country_meta
    if _country_meta is None:
        with open(COUNTRY_META_PATH, "r", encoding="utf-8") as fh:
            _country_meta = json.load(fh)
    return _country_meta


def _load_country_ranges() -> list[tuple[int, int, str]]:
    global _country_ranges
    if _country_ranges is None:
        _country_ranges = []
        with open(COUNTRY_DB_PATH, "r", encoding="utf-8") as fh:
            for raw in fh.read().splitlines():
                if not raw:
                    continue
                start, end, country_code = _parse_csv_line(raw)
                _country_ranges.append((int(start), int(end), country_code))
    return _country_ranges


def _load_asn_ranges() -> list[tuple[int, int, str, str]]:
    global _asn_ranges
    if _asn_ranges is None:
        _asn_ranges = []
        with open(ASN_DB_PATH, "r", encoding="utf-8") as fh:
            for raw in fh.read().splitlines():
                if not raw:
                    continue
                start, end, asn, org = _parse_csv_line(raw)
                _asn_ranges.append((int(start), int(end), asn, org))
    return _asn_ranges


def _fetch_url_text(url: str) -> str:
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": f"{APP_NAME}/ferry-ipdb-updater",
            "Accept": "application/json, text/plain, */*",
        },
    )
    with urllib.request.urlopen(req, timeout=IPDB_TIMEOUT_MS / 1000.0) as resp:
        return resp.read().decode("utf-8")


def _fetch_latest_commit_sha() -> Optional[str]:
    try:
        payload = json.loads(_fetch_url_text(IPDB_COMMIT_URL))
        return payload.get("sha")
    except Exception:
        return None


def _current_dataset_sha() -> Optional[str]:
    try:
        with open(DATASET_SOURCE_PATH, "r", encoding="utf-8") as fh:
            payload = json.load(fh)
        return payload.get("commit") or payload.get("sha")
    except Exception:
        return None


def _write_dataset_source(sha: str) -> None:
    os.makedirs(os.path.dirname(DATASET_SOURCE_PATH), exist_ok=True)
    with open(DATASET_SOURCE_PATH, "w", encoding="utf-8") as fh:
        json.dump(
            {
                "repo": "https://github.com/sapics/ip-location-db",
                "commit": sha,
                "generatedAt": datetime.now(timezone.utc).isoformat(),
                "countryDataset": "geo-whois-asn-country",
                "asnDataset": "iptoasn-asn",
            },
            fh,
            indent=2,
        )


def _refresh_datasets_if_needed_sync(force: bool = False) -> None:
    global _country_meta, _country_ranges, _asn_ranges, _datasets_ready
    with _dataset_refresh_lock:
        if not force:
            _ensure_datasets_loaded()

        current_sha = _current_dataset_sha()
        latest_sha = _fetch_latest_commit_sha()
        if not latest_sha or latest_sha == current_sha:
            return

        country_csv = _fetch_url_text(IPDB_COUNTRY_URL)
        asn_csv = _fetch_url_text(IPDB_ASN_URL)

        os.makedirs(os.path.dirname(COUNTRY_DB_PATH), exist_ok=True)
        with open(f"{COUNTRY_DB_PATH}.tmp", "w", encoding="utf-8") as fh:
            fh.write(country_csv)
        with open(f"{ASN_DB_PATH}.tmp", "w", encoding="utf-8") as fh:
            fh.write(asn_csv)
        os.replace(f"{COUNTRY_DB_PATH}.tmp", COUNTRY_DB_PATH)
        os.replace(f"{ASN_DB_PATH}.tmp", ASN_DB_PATH)
        _write_dataset_source(latest_sha)

        _country_meta = None
        _country_ranges = None
        _asn_ranges = None
        _datasets_ready = False
        _geo_cache.clear()
        _ensure_datasets_loaded()


def _start_dataset_refresh_loop() -> None:
    global _dataset_refresh_started
    if _dataset_refresh_started:
        return
    _dataset_refresh_started = True

    def _loop() -> None:
        while True:
            try:
                _refresh_datasets_if_needed_sync(False)
            except Exception as exc:  # pragma: no cover - background telemetry only
                print(f"dataset refresh failed: {exc}", file=sys.stderr)
            time.sleep(IPDB_REFRESH_MS / 1000.0)

    threading.Thread(target=_loop, daemon=True).start()


def _search_range(ranges: list[tuple], value: int):
    low = 0
    high = len(ranges) - 1
    while low <= high:
        mid = (low + high) // 2
        row = ranges[mid]
        if value < row[0]:
            high = mid - 1
        elif value > row[1]:
            low = mid + 1
        else:
            return row
    return None


def _ensure_datasets_loaded() -> None:
    global _datasets_ready
    if _datasets_ready:
        return
    if not os.path.exists(COUNTRY_DB_PATH) or not os.path.exists(ASN_DB_PATH):
        raise FileNotFoundError("Missing local IP datasets under ./data")
    _load_country_ranges()
    _load_asn_ranges()
    _datasets_ready = True


def _country_meta_for(code: Optional[str]) -> Optional[dict[str, str]]:
    if not code:
        return None
    meta = _load_country_meta().get(code, {})
    continent_code = meta.get("continent", "")
    return {
        "continent": CONTINENT_NAMES.get(continent_code, continent_code),
        "continentCode": continent_code,
        "country": meta.get("name", code),
        "currency": meta.get("currency", ""),
    }


def _is_hosting_org(org: str) -> bool:
    return any(pattern.search(org or "") for pattern in HOSTING_ORG_PATTERNS)


def _is_mobile_org(org: str) -> bool:
    return any(pattern.search(org or "") for pattern in MOBILE_ORG_PATTERNS)


def _lookup_hostname(ip: str) -> Optional[str]:
    if not ip or _is_private_ip(ip):
        return None
    try:
        return socket.gethostbyaddr(re.sub(r"^::ffff:", "", ip))[0]
    except Exception:
        return None


def _sync_geo_lookup(ip: str, fallback_country: Optional[str]) -> Optional[dict]:
    now = time.time()
    cache_key = f"{ip}:{fallback_country or ''}"
    cached = _geo_cache.get(cache_key)
    if cached and cached[1] > now:
        return cached[0]

    try:
        _ensure_datasets_loaded()
        ip_num = _ipv4_to_number(ip)
        country_row = _search_range(_load_country_ranges(), ip_num) if ip_num is not None else None
        asn_row = _search_range(_load_asn_ranges(), ip_num) if ip_num is not None else None
        country_code = (country_row[2] if country_row else None) or fallback_country or ""
        meta = _country_meta_for(country_code)
        reverse = _lookup_hostname(ip)

        data = None
        if country_code or asn_row:
            org = asn_row[3] if asn_row else ""
            asn = asn_row[2] if asn_row else ""
            data = {
                "continent": meta["continent"] if meta else "",
                "continentCode": meta["continentCode"] if meta else "",
                "country": meta["country"] if meta else country_code,
                "countryCode": country_code,
                "region": "",
                "regionName": "",
                "city": "",
                "district": "",
                "zip": "",
                "lat": 0,
                "lon": 0,
                "timezone": "",
                "offset": 0,
                "currency": meta["currency"] if meta else "",
                "isp": org,
                "org": org,
                "as": f"AS{asn}" if asn else "",
                "asname": org,
                "reverse": reverse or "",
                "mobile": _is_mobile_org(org),
                "proxy": False,
                "hosting": _is_hosting_org(org),
                "query": ip,
            }

        _geo_cache[cache_key] = (data, now + GEO_TTL)
        return data
    except Exception:
        _geo_cache[cache_key] = (None, now + GEO_FAIL_TTL)
        return None


async def _lookup_geo(ip: str, fallback_country: Optional[str]) -> Optional[dict]:
    loop = asyncio.get_event_loop()
    return await loop.run_in_executor(None, _sync_geo_lookup, ip, fallback_country)


# ---------------------------------------------------------------------------
# User-Agent Parser
# ---------------------------------------------------------------------------

def _parse_ua(raw: str) -> dict:
    info: dict[str, str] = {
        "raw": raw, "browser": "Unknown", "browserVersion": "",
        "os": "Unknown", "osVersion": "", "device": "Unknown", "engine": "Unknown",
    }
    if not raw:
        return info

    # Browser detection
    browser_patterns: list[tuple[str, str]] = [
        (r"Edg(?:e|A|iOS)?/(\S+)", "Edge"),
        (r"OPR/(\S+)", "Opera"),
        (r"Vivaldi/(\S+)", "Vivaldi"),
        (r"Brave/(\S+)", "Brave"),
        (r"Firefox/(\S+)", "Firefox"),
        (r"SamsungBrowser/(\S+)", "Samsung Internet"),
        (r"UCBrowser/(\S+)", "UC Browser"),
        (r"Chrome/(\S+)", "Chrome"),
        (r"Version/(\S+).*Safari", "Safari"),
        (r"curl/(\S+)", "curl"),
        (r"Wget/(\S+)", "Wget"),
        (r"HTTPie/(\S+)", "HTTPie"),
        (r"Claude-User", "Claude"),
    ]
    for pattern, name in browser_patterns:
        m = re.search(pattern, raw, re.IGNORECASE)
        if m:
            info["browser"] = name
            info["browserVersion"] = m.group(1) if m.lastindex and m.lastindex >= 1 else ""
            break
    if info["browser"] == "Unknown" and re.search(r"bot|crawl|spider|slurp|feed|index", raw, re.IGNORECASE):
        info["browser"] = "Bot"

    # Engine
    if re.search(r"Trident", raw, re.IGNORECASE):
        info["engine"] = "Trident"
    elif re.search(r"Gecko/\d", raw, re.IGNORECASE):
        before = raw.split("Gecko")[0] if "Gecko" in raw else ""
        if not re.search(r"like Gecko", before, re.IGNORECASE):
            info["engine"] = "Gecko"
    if re.search(r"AppleWebKit", raw, re.IGNORECASE):
        info["engine"] = "WebKit"
    if info["browser"] in ("Chrome", "Edge", "Opera", "Vivaldi", "Brave"):
        info["engine"] = "Blink"

    # OS
    m = re.search(r"Windows NT ([\d.]+)", raw, re.IGNORECASE)
    if m:
        info["os"] = "Windows"
        ver_map = {"10.0": "10+", "6.3": "8.1", "6.2": "8", "6.1": "7", "6.0": "Vista"}
        info["osVersion"] = ver_map.get(m.group(1), m.group(1))
    elif re.search(r"Mac OS X ([\d._]+)", raw, re.IGNORECASE):
        info["os"] = "macOS"
        info["osVersion"] = re.search(r"Mac OS X ([\d._]+)", raw, re.IGNORECASE).group(1).replace("_", ".")  # type: ignore[union-attr]
    elif re.search(r"CrOS", raw, re.IGNORECASE):
        info["os"] = "ChromeOS"
    elif re.search(r"Android ([\d.]+)", raw, re.IGNORECASE):
        info["os"] = "Android"
        info["osVersion"] = re.search(r"Android ([\d.]+)", raw, re.IGNORECASE).group(1)  # type: ignore[union-attr]
    elif re.search(r"iPhone OS ([\d_]+)", raw, re.IGNORECASE):
        info["os"] = "iOS"
        info["osVersion"] = re.search(r"iPhone OS ([\d_]+)", raw, re.IGNORECASE).group(1).replace("_", ".")  # type: ignore[union-attr]
    elif re.search(r"iPad.*OS ([\d_]+)", raw, re.IGNORECASE):
        info["os"] = "iPadOS"
        info["osVersion"] = re.search(r"iPad.*OS ([\d_]+)", raw, re.IGNORECASE).group(1).replace("_", ".")  # type: ignore[union-attr]
    elif re.search(r"Linux", raw, re.IGNORECASE):
        info["os"] = "Linux"
    elif re.search(r"FreeBSD", raw, re.IGNORECASE):
        info["os"] = "FreeBSD"

    # Device
    if re.search(r"Mobile|Android.*Mobile|iPhone|iPod", raw, re.IGNORECASE):
        info["device"] = "Mobile"
    elif re.search(r"iPad|Android(?!.*Mobile)|Tablet", raw, re.IGNORECASE):
        info["device"] = "Tablet"
    elif re.search(r"Smart-?TV|Tizen|Web0S|NetCast", raw, re.IGNORECASE):
        info["device"] = "Smart TV"
    elif re.search(r"bot|crawl|spider", raw, re.IGNORECASE):
        info["device"] = "Bot"
    elif re.search(r"curl|wget|httpie|python-requests|go-http|java/", raw, re.IGNORECASE):
        info["device"] = "CLI / Library"
    else:
        info["device"] = "Desktop"

    return info


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _country_flag(code: str) -> str:
    if not code or len(code) != 2:
        return ""
    return chr(ord(code[0].upper()) + 127397) + chr(ord(code[1].upper()) + 127397)


def _country_label(code: Optional[str]) -> str:
    if not code:
        return ""
    meta = _country_meta_for(code)
    name = meta["country"] if meta else code
    suffix = f" ({code})" if name != code else ""
    return f"{_country_flag(code)} {name}{suffix}"


def _ip_version(ip: str) -> str:
    return "IPv6" if ":" in ip else "IPv4"


def _get_client_ip(request: Request) -> str:
    headers = request.headers
    ip = (
        headers.get("cf-connecting-ip")
        or headers.get("true-client-ip")
        or headers.get("x-real-ip")
        or (headers.get("x-forwarded-for", "").split(",")[0].strip())
        or (request.client.host if request.client else "")
        or "unknown"
    )
    return ip


def _get_cf_info(request: Request) -> Optional[dict]:
    ray = request.headers.get("cf-ray")
    if not ray:
        return None

    dc_code = None
    dc_city = None
    dash = ray.rfind("-")
    if dash > 0:
        dc_code = ray[dash + 1:]
        dc_city = CF_DC.get(dc_code)

    scheme = None
    try:
        visitor = json.loads(request.headers.get("cf-visitor", "{}"))
        scheme = visitor.get("scheme")
    except (json.JSONDecodeError, TypeError):
        pass

    return {
        "detected": True,
        "ray": ray[:dash] if dash > 0 else ray,
        "datacenter": dc_code,
        "datacenterCity": dc_city,
        "country": request.headers.get("cf-ipcountry"),
        "scheme": scheme,
        "warp": bool(request.headers.get("cf-warp-tag-id")),
    }


def _parse_as(as_str: str) -> dict:
    m = re.match(r"^(AS\d+)\s*(.*)", as_str)
    if m:
        return {"asn": m.group(1), "asName": m.group(2)}
    return {"asn": as_str, "asName": ""}


def _format_uptime(seconds: float) -> str:
    s = int(seconds)
    d = s // 86400
    h = (s % 86400) // 3600
    m = (s % 3600) // 60
    sec = s % 60
    if d > 0:
        return f"{d}d {h}h {m}m"
    if h > 0:
        return f"{h}h {m}m {sec}s"
    if m > 0:
        return f"{m}m {sec}s"
    return f"{sec}s"


def _esc(s: str) -> str:
    return html.escape(str(s), quote=True)


def _xml_escape(s: str) -> str:
    return (
        str(s)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
        .replace("'", "&apos;")
    )


def _has_proxy_signal(request: Request, cf: Optional[dict]) -> bool:
    hop_count = len([part.strip() for part in request.headers.get("x-forwarded-for", "").split(",") if part.strip()])
    return bool(
        request.headers.get("via")
        or request.headers.get("proxy-connection")
        or request.headers.get("forwarded")
        or hop_count > 1
        or (cf and cf.get("warp"))
    )


def _build_privacy(request: Request, geo: Optional[dict], ua: dict, cf: Optional[dict]) -> Optional[dict]:
    proxy = _has_proxy_signal(request, cf)
    hosting = bool(geo["hosting"]) if geo else False
    mobile = bool(geo["mobile"]) if geo else False
    if not mobile and ua.get("device") == "Mobile":
        mobile = _is_mobile_org(geo.get("org", "") if geo else "")
    if not proxy and not hosting and not mobile:
        return None
    return {"proxy": proxy, "hosting": hosting, "mobile": mobile}


# ---------------------------------------------------------------------------
# Build Payload
# ---------------------------------------------------------------------------

async def _build_payload(request: Request) -> dict:
    ip = _get_client_ip(request)
    cf = _get_cf_info(request)
    geo = await _lookup_geo(ip, cf.get("country") if cf else None)
    ua = _parse_ua(request.headers.get("user-agent", ""))

    langs = [
        part.split(";")[0].strip()
        for part in request.headers.get("accept-language", "").split(",")
        if part.split(";")[0].strip()
    ]
    enc = [
        part.strip()
        for part in request.headers.get("accept-encoding", "").split(",")
        if part.strip()
    ]

    dnt = request.headers.get("dnt") == "1"
    gpc = request.headers.get("sec-gpc") == "1"

    uptime = time.time() - START_TIME
    as_info = _parse_as(geo["as"]) if geo and geo.get("as") else None
    privacy = _build_privacy(request, geo, ua, cf)

    headers_dict: dict[str, str] = {}
    for k, v in request.headers.items():
        headers_dict[k] = v

    return {
        "app": APP_NAME,
        "ferry": f"⛵ Ferry v{FERRY_VERSION}",
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "client": {
            "ip": ip,
            "ipVersion": _ip_version(ip),
            "hostname": geo.get("reverse") if geo else None,
            "geo": {
                "continent": geo["continent"],
                "continentCode": geo["continentCode"],
                "country": geo["country"],
                "countryCode": geo["countryCode"],
                "flag": _country_flag(geo["countryCode"]),
                "region": geo["region"],
                "regionName": geo["regionName"],
                "city": geo["city"],
                "district": geo["district"],
                "zip": geo["zip"],
                "lat": geo["lat"],
                "lon": geo["lon"],
                "timezone": geo["timezone"],
                "utcOffset": geo["offset"],
                "currency": geo["currency"],
            } if geo else None,
            "network": {
                "isp": geo["isp"],
                "org": geo["org"],
                "asn": as_info["asn"],
                "asName": as_info["asName"],
            } if geo and as_info else None,
            "privacy": privacy,
            "userAgent": ua,
            "languages": langs,
            "encoding": enc,
            "dnt": dnt,
            "gpc": gpc,
        },
        "cloudflare": cf,
        "request": {
            "method": request.method,
            "url": str(request.url),
            "protocol": cf["scheme"] if cf and cf.get("scheme") else request.url.scheme,
            "host": request.headers.get("host", ""),
        },
        "server": {
            "hostname": platform.node(),
            "port": APP_PORT,
            "uptime": int(uptime),
            "uptimeHuman": _format_uptime(uptime),
            "runtime": f"Python {sys.version.split()[0]}",
            "platform": platform.system(),
            "arch": platform.machine(),
        },
        "headers": headers_dict,
    }


