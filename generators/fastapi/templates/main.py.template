def _build_text(p: dict) -> str:
    g = p["client"]["geo"]
    n = p["client"]["network"]
    pr = p["client"]["privacy"]
    cf = p["cloudflare"]
    ua = p["client"]["userAgent"]

    t = f"# {p['app']}\n\n"
    t += f"Your IP: {p['client']['ip']}\n"
    if p["client"].get("hostname"):
        t += f"Hostname: {p['client']['hostname']}\n"
    t += f"IP Version: {p['client']['ipVersion']}\n"

    if g:
        t += "\n## Location\n"
        if g.get("continent") or g.get("continentCode"):
            t += f"  Continent:   {g['continent']} ({g['continentCode']})\n"
        t += f"  Country:     {g['flag']} {g['country']} ({g['countryCode']})\n"
        if g.get("regionName"):
            t += f"  Region:      {g['regionName']}\n"
        if g.get("city"):
            t += f"  City:        {g['city']}\n"
        if g.get("district"):
            t += f"  District:    {g['district']}\n"
        if g.get("zip"):
            t += f"  Postal/ZIP:  {g['zip']}\n"
        if g["lat"] or g["lon"]:
            t += f"  Coordinates: {g['lat']}, {g['lon']}\n"
        if g.get("timezone"):
            offset_hr = g["utcOffset"] / 3600
            sign = "+" if g["utcOffset"] >= 0 else ""
            t += f"  Timezone:    {g['timezone']} (UTC{sign}{offset_hr:g})\n"
        if g.get("currency"):
            t += f"  Currency:    {g['currency']}\n"

    if n:
        t += "\n## Network\n"
        t += f"  ISP:          {n['isp']}\n"
        if n.get("org") and n["org"] != n["isp"]:
            t += f"  Organization: {n['org']}\n"
        t += f"  AS Number:    {n['asn']}\n"
        if n.get("asName"):
            t += f"  AS Name:      {n['asName']}\n"

    if pr:
        t += "\n## Privacy\n"
        if pr["hosting"]:
            conn_type = "Datacenter / Hosting"
        elif pr["mobile"]:
            conn_type = "Mobile Network"
        else:
            conn_type = "Residential"
        t += f"  Type:     {conn_type}\n"
        t += f"  Proxy:    {'Detected' if pr['proxy'] else 'Not detected'}\n"
        t += f"  Hosting:  {'Yes' if pr['hosting'] else 'No'}\n"
        t += f"  Mobile:   {'Yes' if pr['mobile'] else 'No'}\n"

    t += "\n## Client\n"
    t += f"  Browser:    {ua['browser']}{' ' + ua['browserVersion'] if ua['browserVersion'] else ''}\n"
    if ua["engine"] != "Unknown":
        t += f"  Engine:     {ua['engine']}\n"
    t += f"  OS:         {ua['os']}{' ' + ua['osVersion'] if ua['osVersion'] else ''}\n"
    t += f"  Device:     {ua['device']}\n"
    if p["client"]["languages"]:
        t += f"  Languages:  {', '.join(p['client']['languages'])}\n"
    if p["client"]["encoding"]:
        t += f"  Encoding:   {', '.join(p['client']['encoding'])}\n"
    t += f"  DNT:        {'Enabled' if p['client']['dnt'] else 'Disabled'}\n"
    if p["client"]["gpc"]:
        t += "  GPC:        Enabled\n"
    t += f"  User-Agent: {ua['raw']}\n"

    if cf:
        t += "\n## Cloudflare\n"
        if cf.get("datacenter"):
            dc = cf["datacenter"]
            if cf.get("datacenterCity"):
                dc += f" ({cf['datacenterCity']})"
            t += f"  Datacenter: {dc}\n"
        if cf.get("ray"):
            t += f"  Ray ID:     {cf['ray']}\n"
        if cf.get("country"):
            t += f"  Country:    {_country_label(cf['country'])}\n"
        if cf.get("scheme"):
            t += f"  Scheme:     {cf['scheme'].upper()}\n"
        t += f"  WARP:       {'Active' if cf['warp'] else 'Inactive'}\n"

    t += "\n## Request\n"
    t += f"  Method:    {p['request']['method']}\n"
    t += f"  URL:       {p['request']['url']}\n"
    t += f"  Protocol:  {p['request']['protocol'].upper()}\n"
    t += f"  Host:      {p['request']['host']}\n"
    t += f"  Timestamp: {p['timestamp']}\n"

    t += "\n## Server\n"
    t += f"  Hostname: {p['server']['hostname']}\n"
    t += f"  Port:     {p['server']['port']}\n"
    t += f"  Uptime:   {p['server']['uptimeHuman']}\n"
    t += f"  Runtime:  {p['server']['runtime']}\n"
    t += f"  Platform: {p['server']['platform']} / {p['server']['arch']}\n"

    t += "\n## Headers\n"
    for k, v in sorted(p["headers"].items(), key=lambda kv: kv[0].lower()):
        t += f"  {k}: {v}\n"

    t += f"\n---\nBuilt with {p['ferry']} \u2014 https://github.com/gastonmorixe/ferry\nFormats: / | /json | /xml | /text\n"
    return t


# ---------------------------------------------------------------------------
# Routes
# ---------------------------------------------------------------------------

@app.get("/health")
async def health():
    return PlainTextResponse(content="ok")


@app.get("/", response_class=HTMLResponse)
async def index(request: Request):
    p = await _build_payload(request)
    return HTMLResponse(content=_build_html(p))


@app.get("/json")
async def json_view(request: Request):
    p = await _build_payload(request)
    return JSONResponse(content=p)


@app.get("/xml")
async def xml_view(request: Request):
    p = await _build_payload(request)
    return Response(content=_build_xml(p), media_type="application/xml")


@app.get("/text")
async def text_view(request: Request):
    p = await _build_payload(request)
    return PlainTextResponse(content=_build_text(p))


@app.on_event("startup")
async def _startup() -> None:
    _start_dataset_refresh_loop()
    await asyncio.to_thread(_ensure_datasets_loaded)
    await asyncio.to_thread(_refresh_datasets_if_needed_sync, False)
