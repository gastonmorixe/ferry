def _row(label: str, value: str, cls: str = "") -> str:
    td_attr = f' class="{cls}"' if cls else ""
    return f"<tr><td>{_esc(label)}</td><td{td_attr}>{value}</td></tr>"


def _badge(text: str, color: str) -> str:
    return f'<span class="badge badge-{color}">{_esc(text)}</span>'


def _build_html(p: dict) -> str:
    g = p["client"]["geo"]
    n = p["client"]["network"]
    pr = p["client"]["privacy"]
    cf = p["cloudflare"]
    ua = p["client"]["userAgent"]

    # Hero
    if g:
        location_text = g.get("city") or g.get("regionName") or g.get("country", "")
        hero_location = f'<span class="ip-flag">{g["flag"]}</span> {_esc(location_text)}'
        if g.get("city") and g.get("country"):
            hero_location += f", {_esc(g['country'])}"
    elif cf and cf.get("country"):
        hero_location = _esc(_country_label(cf["country"]))
    else:
        hero_location = ""

    hero_hostname = ""
    if p["client"].get("hostname"):
        hero_hostname = f'<div class="ip-hostname">{_esc(p["client"]["hostname"])}</div>'

    # Location
    location_rows = ""
    if g:
        if g.get("continent") or g.get("continentCode"):
            location_rows += _row("Continent", f"{_esc(g['continent'])} ({_esc(g['continentCode'])})")
        location_rows += _row("Country", f"{g['flag']} {_esc(g['country'])} ({_esc(g['countryCode'])})")
        if g.get("regionName"):
            location_rows += _row("Region", _esc(g["regionName"]))
        if g.get("city"):
            location_rows += _row("City", _esc(g["city"]))
        if g.get("district"):
            location_rows += _row("District", _esc(g["district"]))
        if g.get("zip"):
            location_rows += _row("Postal / ZIP", _esc(g["zip"]))
        if g["lat"] or g["lon"]:
            location_rows += _row(
                "Coordinates",
                f'<a class="coord-link" href="https://www.openstreetmap.org/?mlat={g["lat"]}&mlon={g["lon"]}#map=12/{g["lat"]}/{g["lon"]}" target="_blank" rel="noopener">{g["lat"]}, {g["lon"]}</a>',
            )
        if g.get("timezone"):
            offset_hr = g["utcOffset"] / 3600
            sign = "+" if g["utcOffset"] >= 0 else ""
            location_rows += _row("Timezone", f"{_esc(g['timezone'])} (UTC{sign}{offset_hr:g})")
        if g.get("currency"):
            location_rows += _row("Currency", _esc(g["currency"]))

    # Network
    network_rows = ""
    if n:
        network_rows += _row("ISP", _esc(n["isp"]))
        if n.get("org") and n["org"] != n["isp"]:
            network_rows += _row("Organization", _esc(n["org"]))
        network_rows += _row("AS Number", f'<span class="mono">{_esc(n["asn"])}</span>')
        if n.get("asName"):
            network_rows += _row("AS Name", _esc(n["asName"]))
    network_rows += _row("IP Version", _esc(p["client"]["ipVersion"]))
    if p["client"].get("hostname"):
        network_rows += _row("Reverse DNS", f'<span class="mono">{_esc(p["client"]["hostname"])}</span>')

    # Privacy
    privacy_rows = ""
    if pr:
        if pr["hosting"]:
            conn_type, conn_color = "Datacenter / Hosting", "yellow"
        elif pr["mobile"]:
            conn_type, conn_color = "Mobile Network", "blue"
        else:
            conn_type, conn_color = "Residential", "green"
        privacy_rows += _row("Connection Type", _badge(conn_type, conn_color))
        privacy_rows += _row("Proxy / VPN", _badge("Detected", "red") if pr["proxy"] else _badge("Not Detected", "green"))
        privacy_rows += _row("Hosting / DC", _badge("Yes", "yellow") if pr["hosting"] else _badge("No", "green"))
        privacy_rows += _row("Mobile Network", _badge("Yes", "blue") if pr["mobile"] else _badge("No", "gray"))

    # Client
    client_rows = ""
    if ua["browser"] != "Unknown":
        browser_text = _esc(ua["browser"])
        if ua["browserVersion"]:
            browser_text += " " + _esc(ua["browserVersion"])
        client_rows += _row("Browser", browser_text)
    else:
        truncated = ua["raw"][:80] + ("\u2026" if len(ua["raw"]) > 80 else "")
        client_rows += _row("Browser", f'<span class="unavailable">{_esc(truncated)}</span>')
    if ua["engine"] != "Unknown":
        client_rows += _row("Engine", _esc(ua["engine"]))
    if ua["os"] != "Unknown":
        os_text = _esc(ua["os"])
        if ua["osVersion"]:
            os_text += " " + _esc(ua["osVersion"])
        client_rows += _row("OS", os_text)
    else:
        client_rows += _row("OS", '<span class="unavailable">Unknown</span>')
    client_rows += _row("Device", _esc(ua["device"]))
    if p["client"]["languages"]:
        client_rows += _row("Languages", _esc(", ".join(p["client"]["languages"])))
    if p["client"]["encoding"]:
        client_rows += _row("Encoding", _esc(", ".join(p["client"]["encoding"])))
    client_rows += _row("Do Not Track", _badge("Enabled", "green") if p["client"]["dnt"] else _badge("Disabled", "gray"))
    if p["client"]["gpc"]:
        client_rows += _row("Global Privacy", _badge("Enabled", "green"))

    # Cloudflare
    cf_section = ""
    if cf:
        cf_rows = ""
        if cf.get("datacenter"):
            dc_label = f'<span class="mono">{_esc(cf["datacenter"])}</span>'
            if cf.get("datacenterCity"):
                dc_label += f' \u2014 {_esc(cf["datacenterCity"])}'
            cf_rows += _row("Datacenter", dc_label)
        if cf.get("ray"):
            cf_rows += _row("Ray ID", f'<span class="mono">{_esc(cf["ray"])}</span>')
        if cf.get("country"):
            cf_rows += _row("Country", _esc(_country_label(cf["country"])))
        if cf.get("scheme"):
            cf_rows += _row("Scheme", _esc(cf["scheme"].upper()))
        cf_rows += _row("WARP", _badge("Active", "purple") if cf["warp"] else _badge("Inactive", "gray"))
        cf_section = (
            f'<h2>Cloudflare</h2><table><tbody>{cf_rows}</tbody></table>\n'
            f'    <p class="section-note">Request proxied through Cloudflare \u2014 client TLS terminates at the edge</p>'
        )

    # Request
    req_rows = (
        _row("Method", f'<span class="mono">{_esc(p["request"]["method"])}</span>')
        + _row("URL", f'<span class="mono">{_esc(p["request"]["url"])}</span>')
        + _row("Protocol", _esc(p["request"]["protocol"].upper()))
        + _row("Host", _esc(p["request"]["host"]))
        + _row("Timestamp", f'<span class="mono">{_esc(p["timestamp"])}</span>')
    )

    # Server
    srv = p["server"]
    srv_rows = (
        _row("Hostname", f'<span class="mono">{_esc(srv["hostname"])}</span>')
        + _row("Port", str(srv["port"]))
        + _row("Uptime", _esc(srv["uptimeHuman"]))
        + _row("Runtime", _esc(srv["runtime"]))
        + _row("Platform", f'{_esc(srv["platform"])} / {_esc(srv["arch"])}')
    )

    # Headers
    sorted_headers = sorted(p["headers"].items(), key=lambda kv: kv[0].lower())
    header_rows = "\n".join(
        f'<tr><td>{_esc(k)}</td><td class="mono">{_esc(v)}</td></tr>'
        for k, v in sorted_headers
    )

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{_esc(APP_NAME)}</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="container">
    <h1>{_esc(APP_NAME)}</h1>
    <p class="subtitle">Built with <a href="https://github.com/gastonmorixe/ferry" target="_blank" rel="noopener">⛵ Ferry</a></p>

    <div class="ip-hero">
      <div class="ip-label">Your IP Address</div>
      <div class="ip-address">{_esc(p["client"]["ip"])}</div>
      {f'<div class="ip-meta">{hero_location}</div>' if hero_location else ""}
      {hero_hostname}
    </div>

    {f'<h2>Location</h2><table><tbody>{location_rows}</tbody></table>' if g else ""}

    {f'<h2>Network</h2><table><tbody>{network_rows}</tbody></table>' if network_rows else ""}

    {f'<h2>Privacy &amp; Security</h2><table><tbody>{privacy_rows}</tbody></table>' if pr else ""}

    <h2>Client</h2>
    <table><tbody>{client_rows}</tbody></table>

    {cf_section}

    <h2>Request</h2>
    <table><tbody>{req_rows}</tbody></table>

    <h2>Server</h2>
    <table><tbody>{srv_rows}</tbody></table>

    <details>
      <summary>Headers <span class="count">({len(sorted_headers)})</span></summary>
      <table><tbody>
        {header_rows}
      </tbody></table>
    </details>

    <div class="formats">
      <a class="active" href="/">HTML</a>
      <a href="/json">JSON</a>
      <a href="/xml">XML</a>
      <a href="/text">Text</a>
    </div>

    <footer>Built with <a href="https://github.com/gastonmorixe/ferry" target="_blank" rel="noopener">⛵ Ferry</a></footer>
  </div>
</body>
</html>"""


# ---------------------------------------------------------------------------
# XML Renderer
# ---------------------------------------------------------------------------

def _xel(tag: str, val: Any) -> str:
    if val is None:
        return f"  <{tag} />"
    return f"  <{tag}>{_xml_escape(str(val))}</{tag}>"


def _build_xml(p: dict) -> str:
    g = p["client"]["geo"]
    n = p["client"]["network"]
    pr = p["client"]["privacy"]
    cf = p["cloudflare"]
    ua = p["client"]["userAgent"]

    hdrs = "\n".join(
        f'      <header name="{_xml_escape(k)}">{_xml_escape(v)}</header>'
        for k, v in sorted(p["headers"].items(), key=lambda kv: kv[0].lower())
    )

    geo_xml = "  <geo />"
    if g:
        geo_xml = f"""  <geo>
    {_xel("continent", g["continent"])}
    {_xel("continentCode", g["continentCode"])}
    {_xel("country", g["country"])}
    {_xel("countryCode", g["countryCode"])}
    {_xel("flag", g["flag"])}
    {_xel("regionName", g["regionName"])}
    {_xel("city", g["city"])}
    {_xel("district", g["district"])}
    {_xel("zip", g["zip"])}
    {_xel("lat", g["lat"])}
    {_xel("lon", g["lon"])}
    {_xel("timezone", g["timezone"])}
    {_xel("utcOffset", g["utcOffset"])}
    {_xel("currency", g["currency"])}
    </geo>"""

    net_xml = "  <network />"
    if n:
        net_xml = f"""  <network>
    {_xel("isp", n["isp"])}
    {_xel("org", n["org"])}
    {_xel("asn", n["asn"])}
    {_xel("asName", n["asName"])}
    </network>"""

    priv_xml = "  <privacy />"
    if pr:
        priv_xml = f"""  <privacy>
    {_xel("proxy", pr["proxy"])}
    {_xel("hosting", pr["hosting"])}
    {_xel("mobile", pr["mobile"])}
    </privacy>"""

    cf_xml = "  <cloudflare />"
    if cf:
        cf_xml = f"""  <cloudflare>
  {_xel("detected", True)}
  {_xel("ray", cf["ray"])}
  {_xel("datacenter", cf["datacenter"])}
  {_xel("datacenterCity", cf["datacenterCity"])}
  {_xel("country", cf["country"])}
  {_xel("scheme", cf["scheme"])}
  {_xel("warp", cf["warp"])}
  </cloudflare>"""

    langs_xml = "".join(f"<lang>{_xml_escape(l)}</lang>" for l in p["client"]["languages"])
    enc_xml = "".join(f"<enc>{_xml_escape(e)}</enc>" for e in p["client"]["encoding"])

    return f"""<?xml version="1.0" encoding="UTF-8"?>
<response>
  <app>{_xml_escape(p["app"])}</app>
  <ferry>{_xml_escape(p["ferry"])}</ferry>
  <timestamp>{_xml_escape(p["timestamp"])}</timestamp>
  <client>
  {_xel("ip", p["client"]["ip"])}
  {_xel("ipVersion", p["client"]["ipVersion"])}
  {_xel("hostname", p["client"]["hostname"])}
  {geo_xml}
  {net_xml}
  {priv_xml}
    <userAgent>
    {_xel("raw", ua["raw"])}
    {_xel("browser", ua["browser"])}
    {_xel("browserVersion", ua["browserVersion"])}
    {_xel("os", ua["os"])}
    {_xel("osVersion", ua["osVersion"])}
    {_xel("device", ua["device"])}
    {_xel("engine", ua["engine"])}
    </userAgent>
    <languages>{langs_xml}</languages>
    <encoding>{enc_xml}</encoding>
  {_xel("dnt", p["client"]["dnt"])}
  {_xel("gpc", p["client"]["gpc"])}
  </client>
  {cf_xml}
  <request>
  {_xel("method", p["request"]["method"])}
  {_xel("url", p["request"]["url"])}
  {_xel("protocol", p["request"]["protocol"])}
  {_xel("host", p["request"]["host"])}
  </request>
  <server>
  {_xel("hostname", p["server"]["hostname"])}
  {_xel("port", p["server"]["port"])}
  {_xel("uptime", p["server"]["uptime"])}
  {_xel("uptimeHuman", p["server"]["uptimeHuman"])}
  {_xel("runtime", p["server"]["runtime"])}
  {_xel("platform", p["server"]["platform"])}
  {_xel("arch", p["server"]["arch"])}
  </server>
  <headers>
{hdrs}
  </headers>
</response>"""


