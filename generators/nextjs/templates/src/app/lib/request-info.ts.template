interface SourceManifest {
  sapics?: { commit?: string; fetchedAt?: string }
  x4bnet?: { commit?: string; fetchedAt?: string }
  tor?: { fetchedAt?: string }
  peeringdb?: { fetchedAt?: string }
}

function readManifest(): SourceManifest {
  try {
    return JSON.parse(fs.readFileSync(DATASET_SOURCE_PATH, 'utf8')) as SourceManifest
  } catch {
    return {}
  }
}

function writeManifest(m: SourceManifest): void {
  fs.mkdirSync(DATA_DIR, { recursive: true })
  fs.writeFileSync(DATASET_SOURCE_PATH, JSON.stringify(m, null, 2), 'utf8')
}

function isPrivateIp(ip: string): boolean {
  if (!ip || ip === 'unknown' || ip === '::1' || ip === '127.0.0.1') return true
  const normalized = ip.replace(/^::ffff:/, '')
  if (normalized !== ip) ip = normalized
  if (ip.startsWith('10.') || ip.startsWith('192.168.')) return true
  if (ip.startsWith('172.')) {
    const oct = parseInt(ip.split('.')[1], 10)
    if (oct >= 16 && oct <= 31) return true
  }
  if (ip.startsWith('fc') || ip.startsWith('fd')) return true
  return false
}

function parseCsvLine(line: string): string[] {
  const out: string[] = []
  let current = ''
  let inQuotes = false
  for (let i = 0; i < line.length; i += 1) {
    const ch = line[i]
    if (ch === '"') {
      if (inQuotes && line[i + 1] === '"') { current += '"'; i += 1 }
      else inQuotes = !inQuotes
    } else if (ch === ',' && !inQuotes) { out.push(current); current = '' }
    else current += ch
  }
  out.push(current)
  return out
}

function ipv4ToNumber(ip: string): number | null {
  const normalized = ip.replace(/^::ffff:/, '')
  if (!/^\d+\.\d+\.\d+\.\d+$/.test(normalized)) return null
  const parts = normalized.split('.').map((part) => Number(part))
  if (parts.length !== 4 || parts.some((part) => !Number.isInteger(part) || part < 0 || part > 255)) return null
  return (((parts[0] * 256 + parts[1]) * 256 + parts[2]) * 256 + parts[3]) >>> 0
}

function parseCidr(cidr: string): NumRange | null {
  const slash = cidr.indexOf('/')
  if (slash < 0) {
    const ip = ipv4ToNumber(cidr)
    return ip === null ? null : { start: ip, end: ip }
  }
  const ip = ipv4ToNumber(cidr.slice(0, slash))
  const prefix = parseInt(cidr.slice(slash + 1), 10)
  if (ip === null || !Number.isFinite(prefix) || prefix < 0 || prefix > 32) return null
  const mask = prefix === 0 ? 0 : (0xFFFFFFFF << (32 - prefix)) >>> 0
  const start = (ip & mask) >>> 0
  const end = (start | (~mask >>> 0)) >>> 0
  return { start, end }
}

function loadCountryMeta(): Record<string, CountryMeta> {
  if (!countryMeta) {
    countryMeta = JSON.parse(fs.readFileSync(COUNTRY_META_PATH, 'utf8')) as Record<string, CountryMeta>
  }
  return countryMeta
}

function loadCountryRanges(): CountryRange[] {
  if (!countryRanges) {
    const lines = fs.readFileSync(COUNTRY_DB_PATH, 'utf8').split(/\r?\n/).filter(Boolean)
    countryRanges = lines.map((line) => {
      const [start, end, countryCode] = parseCsvLine(line)
      return { start: Number(start), end: Number(end), countryCode }
    })
  }
  return countryRanges
}

function loadAsnRanges(): AsnRange[] {
  if (!asnRanges) {
    const lines = fs.readFileSync(ASN_DB_PATH, 'utf8').split(/\r?\n/).filter(Boolean)
    asnRanges = lines.map((line) => {
      const [start, end, asn, org] = parseCsvLine(line)
      return { start: Number(start), end: Number(end), asn, org }
    })
  }
  return asnRanges
}

function loadCidrRanges(filePath: string): NumRange[] {
  const out: NumRange[] = []
  const text = fs.readFileSync(filePath, 'utf8')
  for (const raw of text.split(/\r?\n/)) {
    const line = raw.trim()
    if (!line || line.startsWith('#')) continue
    const r = parseCidr(line)
    if (r) out.push(r)
  }
  out.sort((a, b) => a.start - b.start)
  return out
}

function loadVpnRanges(): NumRange[] {
  if (!vpnRanges) vpnRanges = loadCidrRanges(VPN_CIDR_PATH)
  return vpnRanges
}

function loadDcRanges(): NumRange[] {
  if (!dcRanges) dcRanges = loadCidrRanges(DC_CIDR_PATH)
  return dcRanges
}

function loadTorExits(): Set<number> {
  if (!torExits) {
    const set = new Set<number>()
    for (const raw of fs.readFileSync(TOR_EXITS_PATH, 'utf8').split(/\r?\n/)) {
      const ip = raw.trim()
      if (!ip || ip.startsWith('#')) continue
      const n = ipv4ToNumber(ip)
      if (n !== null) set.add(n)
    }
    torExits = set
  }
  return torExits
}

function loadPeeringdbTypes(): Map<string, string> {
  if (!peeringdbTypes) {
    const data = JSON.parse(fs.readFileSync(PEERINGDB_PATH, 'utf8')) as Record<string, string>
    peeringdbTypes = new Map(Object.entries(data))
  }
  return peeringdbTypes
}

function searchRange<T extends NumRange>(ranges: T[], value: number): T | null {
  let low = 0
  let high = ranges.length - 1
  while (low <= high) {
    const mid = (low + high) >> 1
    const row = ranges[mid]
    if (value < row.start) high = mid - 1
    else if (value > row.end) low = mid + 1
    else return row
  }
  return null
}

async function fetchText(url: string): Promise<string> {
  const ctrl = new AbortController()
  const timer = setTimeout(() => ctrl.abort(), IPDB_TIMEOUT_MS)
  try {
    const res = await fetch(url, {
      signal: ctrl.signal,
      headers: {
        'User-Agent': `${APP_NAME}/ferry-ipdb-updater`,
        'Accept': 'application/json, text/plain, */*',
      },
      cache: 'no-store',
    })
    if (!res.ok) throw new Error(`HTTP ${res.status}`)
    return await res.text()
  } finally {
    clearTimeout(timer)
  }
}

async function fetchMainCommitSha(commitUrl: string): Promise<string | null> {
  try {
    const parsed = JSON.parse(await fetchText(commitUrl)) as { sha?: string }
    return parsed.sha || null
  } catch {
    return null
  }
}

async function writeAtomic(target: string, contents: string): Promise<void> {
  fs.mkdirSync(path.dirname(target), { recursive: true })
  const tmp = `${target}.tmp`
  fs.writeFileSync(tmp, contents, 'utf8')
  fs.renameSync(tmp, target)
}

function isStale(fetchedAt: string | undefined, maxAgeMs: number): boolean {
  if (!fetchedAt) return true
  const t = Date.parse(fetchedAt)
  if (!Number.isFinite(t)) return true
  return Date.now() - t > maxAgeMs
}

const refreshLocks: Record<string, Promise<void> | undefined> = {}
function once(key: string, fn: () => Promise<void>): Promise<void> {
  if (refreshLocks[key]) return refreshLocks[key]!
  const p = fn().finally(() => { delete refreshLocks[key] })
  refreshLocks[key] = p
  return p
}

async function refreshSapics(force: boolean): Promise<void> {
  return once('sapics', async () => {
    const manifest = readManifest()
    if (!force && !isStale(manifest.sapics?.fetchedAt, SAPICS_REFRESH_MS)) return
    const latest = await fetchMainCommitSha(SAPICS_COMMIT_URL)
    if (!latest) return
    if (!force && latest === manifest.sapics?.commit) {
      writeManifest({ ...manifest, sapics: { ...manifest.sapics, fetchedAt: new Date().toISOString() } })
      return
    }
    const [countryCsv, asnCsv] = await Promise.all([
      fetchText(SAPICS_COUNTRY_URL),
      fetchText(SAPICS_ASN_URL),
    ])
    await writeAtomic(COUNTRY_DB_PATH, countryCsv)
    await writeAtomic(ASN_DB_PATH, asnCsv)
    countryRanges = null
    asnRanges = null
    geoCache.clear()
    writeManifest({ ...manifest, sapics: { commit: latest, fetchedAt: new Date().toISOString() } })
  })
}

async function refreshX4bnet(force: boolean): Promise<void> {
  return once('x4bnet', async () => {
    const manifest = readManifest()
    if (!force && !isStale(manifest.x4bnet?.fetchedAt, X4BNET_REFRESH_MS)) return
    const latest = await fetchMainCommitSha(X4BNET_COMMIT_URL)
    if (!latest) return
    if (!force && latest === manifest.x4bnet?.commit) {
      writeManifest({ ...manifest, x4bnet: { ...manifest.x4bnet, fetchedAt: new Date().toISOString() } })
      return
    }
    const [vpnTxt, dcTxt] = await Promise.all([
      fetchText(X4BNET_VPN_URL),
      fetchText(X4BNET_DC_URL),
    ])
    await writeAtomic(VPN_CIDR_PATH, vpnTxt)
    await writeAtomic(DC_CIDR_PATH, dcTxt)
    vpnRanges = null
    dcRanges = null
    writeManifest({ ...manifest, x4bnet: { commit: latest, fetchedAt: new Date().toISOString() } })
  })
}

async function refreshTor(force: boolean): Promise<void> {
  return once('tor', async () => {
    const manifest = readManifest()
    if (!force && !isStale(manifest.tor?.fetchedAt, TOR_REFRESH_MS)) return
    const txt = await fetchText(TOR_EXITS_URL)
    await writeAtomic(TOR_EXITS_PATH, txt)
    torExits = null
    writeManifest({ ...manifest, tor: { fetchedAt: new Date().toISOString() } })
  })
}

async function refreshPeeringdb(force: boolean): Promise<void> {
  return once('peeringdb', async () => {
    const manifest = readManifest()
    if (!force && !isStale(manifest.peeringdb?.fetchedAt, PEERINGDB_REFRESH_MS)) return
    const raw = JSON.parse(await fetchText(PEERINGDB_URL)) as { data?: Array<{ asn?: number; info_type?: string }> }
    const out: Record<string, string> = {}
    for (const row of raw.data || []) {
      if (row.asn && row.info_type) out[String(row.asn)] = row.info_type
    }
    await writeAtomic(PEERINGDB_PATH, JSON.stringify(out))
    peeringdbTypes = null
    writeManifest({ ...manifest, peeringdb: { fetchedAt: new Date().toISOString() } })
  })
}

async function refreshAll(force = false): Promise<void> {
  await Promise.allSettled([
    refreshSapics(force),
    refreshX4bnet(force),
    refreshTor(force),
    refreshPeeringdb(force),
  ])
}

function ensureDatasetsLoaded(): void {
  if (datasetsReady) return
  if (!fs.existsSync(COUNTRY_DB_PATH) || !fs.existsSync(ASN_DB_PATH)) {
    throw new Error('Missing local IP datasets under ./data — run scripts/update-ipdb-assets.sh')
  }
  loadCountryRanges()
  loadAsnRanges()
  if (fs.existsSync(VPN_CIDR_PATH)) loadVpnRanges()
  if (fs.existsSync(DC_CIDR_PATH)) loadDcRanges()
  if (fs.existsSync(TOR_EXITS_PATH)) loadTorExits()
  if (fs.existsSync(PEERINGDB_PATH)) loadPeeringdbTypes()
  datasetsReady = true
}

function countryMetaFor(code: string | null): { continent: string; continentCode: string; country: string; currency: string } | null {
  if (!code) return null
  const meta = loadCountryMeta()[code]
  return {
    continent: meta?.continent ? (CONTINENT_NAMES[meta.continent] || meta.continent) : '',
    continentCode: meta?.continent || '',
    country: meta?.name || code,
    currency: meta?.currency || '',
  }
}

async function lookupHostname(ip: string): Promise<string | null> {
  if (!ip || isPrivateIp(ip)) return null
  try {
    const names = await Promise.race([
      dns.promises.reverse(ip.replace(/^::ffff:/, '')),
      new Promise<string[]>((_, reject) => setTimeout(() => reject(new Error('timeout')), 1200)),
    ])
    return names[0] || null
  } catch {
    return null
  }
}

// Country precedence: trust Cloudflare's cf-ipcountry over the local CSV.
// Rationale: Cloudflare's geo is realtime + authoritative for the routing layer;
// public ASN-derived CSVs inherit the ASN's "home" country, which over-flags
// regional carriers (e.g. AS11664 "CLARO ARGENTINA" serving Uruguay).
async function lookupGeo(ip: string, cfCountry: string | null): Promise<GeoData | null> {
  const cacheKey = `${ip}:${cfCountry || ''}`
  const cached = geoCache.get(cacheKey)
  if (cached && cached.exp > Date.now()) return cached.data

  try {
    ensureDatasetsLoaded()
    void refreshAll().catch(() => {})
    const ipNum = ipv4ToNumber(ip)
    const localCountry = ipNum === null ? null : (searchRange(loadCountryRanges(), ipNum)?.countryCode || null)
    const asnRow = ipNum === null ? null : searchRange(loadAsnRanges(), ipNum)
    const countryCode = cfCountry || localCountry || ''
    const meta = countryMetaFor(countryCode)
    const reverse = await lookupHostname(ip)

    const data = (countryCode || asnRow) ? {
      continent: meta?.continent || '',
      continentCode: meta?.continentCode || '',
      country: meta?.country || countryCode,
      countryCode,
      region: '',
      regionName: '',
      city: '',
      district: '',
      zip: '',
      lat: 0,
      lon: 0,
      timezone: '',
      offset: 0,
      currency: meta?.currency || '',
      isp: asnRow?.org || '',
      org: asnRow?.org || '',
      as: asnRow ? `AS${asnRow.asn}` : '',
      asname: asnRow?.org || '',
      reverse: reverse || '',
      query: ip,
    } satisfies GeoData : null

    geoCache.set(cacheKey, { data, exp: Date.now() + GEO_TTL })
    return data
  } catch {
    geoCache.set(cacheKey, { data: null, exp: Date.now() + GEO_FAIL_TTL })
    return null
  }
}

function parseUA(raw: string): UaInfo {
  const r: UaInfo = { raw, browser: 'Unknown', browserVersion: '', os: 'Unknown', osVersion: '', device: 'Unknown', engine: 'Unknown' }
  if (!raw) return r

  const b: [RegExp, string][] = [
    [/Edg(?:e|A|iOS)?\/(\S+)/i, 'Edge'],
    [/OPR\/(\S+)/i, 'Opera'],
    [/Vivaldi\/(\S+)/i, 'Vivaldi'],
    [/Brave\/(\S+)/i, 'Brave'],
    [/Firefox\/(\S+)/i, 'Firefox'],
    [/SamsungBrowser\/(\S+)/i, 'Samsung Internet'],
    [/UCBrowser\/(\S+)/i, 'UC Browser'],
    [/Chrome\/(\S+)/i, 'Chrome'],
    [/Version\/(\S+).*Safari/i, 'Safari'],
    [/curl\/(\S+)/i, 'curl'],
    [/Wget\/(\S+)/i, 'Wget'],
    [/HTTPie\/(\S+)/i, 'HTTPie'],
    [/Claude-User/i, 'Claude'],
  ]
  for (const [re, name] of b) {
    const m = raw.match(re)
    if (m) { r.browser = name; r.browserVersion = m[1] || ''; break }
  }
  if (r.browser === 'Unknown' && /bot|crawl|spider|slurp|feed|index/i.test(raw)) r.browser = 'Bot'

  if (/Trident/i.test(raw)) r.engine = 'Trident'
  else if (/Gecko\/\d/i.test(raw) && !/like Gecko/i.test(raw.split('Gecko')[0] || '')) r.engine = 'Gecko'
  if (/AppleWebKit/i.test(raw)) r.engine = 'WebKit'
  if (r.browser === 'Chrome' || r.browser === 'Edge' || r.browser === 'Opera' || r.browser === 'Vivaldi' || r.browser === 'Brave') r.engine = 'Blink'

  if (/Windows NT ([\d.]+)/i.test(raw)) {
    r.os = 'Windows'; const v = RegExp.$1
    r.osVersion = ({ '10.0': '10+', '6.3': '8.1', '6.2': '8', '6.1': '7', '6.0': 'Vista' } as Record<string, string>)[v] || v
  } else if (/Mac OS X ([\d._]+)/i.test(raw)) { r.os = 'macOS'; r.osVersion = RegExp.$1.replace(/_/g, '.') }
  else if (/CrOS/i.test(raw)) r.os = 'ChromeOS'
  else if (/Android ([\d.]+)/i.test(raw)) { r.os = 'Android'; r.osVersion = RegExp.$1 }
  else if (/iPhone OS ([\d_]+)/i.test(raw)) { r.os = 'iOS'; r.osVersion = RegExp.$1.replace(/_/g, '.') }
  else if (/iPad.*OS ([\d_]+)/i.test(raw)) { r.os = 'iPadOS'; r.osVersion = RegExp.$1.replace(/_/g, '.') }
  else if (/Linux/i.test(raw)) r.os = 'Linux'
  else if (/FreeBSD/i.test(raw)) r.os = 'FreeBSD'

  if (/Mobile|Android.*Mobile|iPhone|iPod/i.test(raw)) r.device = 'Mobile'
  else if (/iPad|Android(?!.*Mobile)|Tablet/i.test(raw)) r.device = 'Tablet'
  else if (/Smart-?TV|Tizen|Web0S|NetCast/i.test(raw)) r.device = 'Smart TV'
  else if (/bot|crawl|spider/i.test(raw)) r.device = 'Bot'
  else if (/curl|wget|httpie|python-requests|go-http|java\//i.test(raw)) r.device = 'CLI / Library'
  else r.device = 'Desktop'

  return r
}

export function countryFlag(code: string): string {
  if (!code || code.length !== 2) return ''
  return String.fromCodePoint(code.toUpperCase().charCodeAt(0) + 127397, code.toUpperCase().charCodeAt(1) + 127397)
}

export function countryLabel(code: string | null): string {
  if (!code) return ''
  const meta = countryMetaFor(code)
  const name = meta?.country || code
  return `${countryFlag(code)} ${name}${name !== code ? ` (${code})` : ''}`
}

function ipVersion(ip: string): string {
  return ip.includes(':') ? 'IPv6' : 'IPv4'
}

function getClientIp(hdrs: ReadonlyHeaders): string {
  return (
    hdrs.get('cf-connecting-ip') ||
    hdrs.get('true-client-ip') ||
    hdrs.get('x-real-ip') ||
    (hdrs.get('x-forwarded-for') || '').split(',')[0].trim() ||
    'unknown'
  )
}

function getCfInfo(hdrs: ReadonlyHeaders): Payload['cloudflare'] {
  const ray = hdrs.get('cf-ray')
  if (!ray) return null

  let dcCode: string | null = null
  let dcCity: string | null = null
  const dash = ray.lastIndexOf('-')
  if (dash > 0) {
    dcCode = ray.slice(dash + 1)
    dcCity = CF_DC[dcCode] || null
  }

  let scheme: string | null = null
  try { scheme = JSON.parse(hdrs.get('cf-visitor') || '{}').scheme || null } catch {}

  return {
    detected: true,
    ray: dash > 0 ? ray.slice(0, dash) : ray,
    datacenter: dcCode,
    datacenterCity: dcCity,
    country: hdrs.get('cf-ipcountry') || null,
    scheme,
  }
}

function parseAs(as: string): { asn: string; asName: string } {
  const m = as.match(/^(AS\d+)\s*(.*)/)
  return m ? { asn: m[1], asName: m[2] } : { asn: as, asName: '' }
}

function formatUptime(ms: number): string {
  const s = Math.floor(ms / 1000)
  const d = Math.floor(s / 86400)
  const h = Math.floor((s % 86400) / 3600)
  const m = Math.floor((s % 3600) / 60)
  const sec = s % 60
  if (d > 0) return `${d}d ${h}h ${m}m`
  if (h > 0) return `${h}h ${m}m ${sec}s`
  if (m > 0) return `${m}m ${sec}s`
  return `${sec}s`
}

function flatHeaders(hdrs: ReadonlyHeaders): Record<string, string> {
  const out: Record<string, string> = {}
  hdrs.forEach((value, key) => { out[key] = value })
  return out
}

export function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
}

function hasForwardedHeader(hdrs: ReadonlyHeaders): boolean {
  return Boolean(hdrs.get('via') || hdrs.get('proxy-connection') || hdrs.get('forwarded'))
}

function asnNumeric(asString: string | undefined): string | null {
  if (!asString) return null
  const m = asString.match(/^AS(\d+)/i)
  return m ? m[1] : null
}

function classify(ip: string, geo: GeoData | null, ua: UaInfo, hdrs: ReadonlyHeaders): Privacy {
  const sources: string[] = []
  const ipNum = ipv4ToNumber(ip)

  // Hard signals (CIDR/IP-level lookups → high confidence)
  const tor = ipNum !== null && torExits !== null && torExits.has(ipNum)
  if (tor) sources.push('tor-exits')

  const inVpnList = ipNum !== null && vpnRanges !== null && !!searchRange(vpnRanges, ipNum)
  if (inVpnList) sources.push('x4bnet-vpn')

  const inDcList = ipNum !== null && dcRanges !== null && !!searchRange(dcRanges, ipNum)
  if (inDcList) sources.push('x4bnet-datacenter')

  // ASN-level classification (medium confidence)
  const asn = asnNumeric(geo?.as)
  const pdbType = asn && peeringdbTypes ? peeringdbTypes.get(asn) || null : null
  if (pdbType) sources.push(`peeringdb:${pdbType}`)
  const pdbHosting = pdbType === 'Content'
  const pdbIsp = pdbType === 'Cable/DSL/ISP' || pdbType === 'NSP'
  const pdbEnterprise = pdbType === 'Enterprise' || pdbType === 'Network Services'

  // rDNS hints (medium confidence)
  const reverse = (geo?.reverse || '').toLowerCase()
  const rDnsMobile = MOBILE_HOST_PATTERNS.some((p) => p.test(reverse))
  const rDnsCarrier = CARRIER_HOST_PATTERNS.some((p) => p.test(reverse))
  const rDnsResidential = RESIDENTIAL_HOST_PATTERNS.some((p) => p.test(reverse))
  if (rDnsMobile) sources.push('rdns:mobile')
  else if (rDnsCarrier) sources.push('rdns:carrier')
  if (rDnsResidential) sources.push('rdns:residential')

  // HTTP-layer signals
  const forwarded = hasForwardedHeader(hdrs)
  if (forwarded) sources.push('http-forwarded')

  // Final booleans
  const vpn = inVpnList || tor
  const hosting = inDcList || pdbHosting || pdbEnterprise
  // Mobile: strict rDNS match, OR carrier-name rDNS combined with a mobile UA.
  const mobile = rDnsMobile || (rDnsCarrier && ua.device === 'Mobile')
  // Residential: ISP-classified AS or residential rDNS, AND not flagged as hosting/vpn/tor.
  const residential = (rDnsResidential || (pdbIsp && !rDnsCarrier)) && !hosting && !vpn && !tor

  const high = tor || inVpnList || inDcList
  const medium = !high && (pdbType !== null || rDnsMobile || rDnsCarrier || rDnsResidential || forwarded)
  const confidence: Privacy['confidence'] = high ? 'high' : medium ? 'medium' : 'low'

  return { tor, vpn, hosting, mobile, residential, forwarded, confidence, sources }
}

export async function buildPayload(hdrs: ReadonlyHeaders, url: string): Promise<Payload> {
  const ip = getClientIp(hdrs)
  const cf = getCfInfo(hdrs)
  const geo = await lookupGeo(ip, cf?.country || null)
  const ua = parseUA(hdrs.get('user-agent') || '')

  const langs = (hdrs.get('accept-language') || '')
    .split(',').map((l) => l.split(';')[0].trim()).filter(Boolean)

  const enc = (hdrs.get('accept-encoding') || '')
    .split(',').map((e) => e.trim()).filter(Boolean)

  const dnt = hdrs.get('dnt') === '1'
  const gpc = hdrs.get('sec-gpc') === '1'

  const uptime = Date.now() - START_TIME
  const asInfo = geo?.as ? parseAs(geo.as) : null
  const privacy = classify(ip, geo, ua, hdrs)

  return {
    app: APP_NAME,
    ferry: '⛵ Ferry v{{FERRY_VERSION}}',
    timestamp: new Date().toISOString(),
    client: {
      ip,
      ipVersion: ipVersion(ip),
      hostname: geo?.reverse || null,
      geo: geo ? {
        continent: geo.continent,
        continentCode: geo.continentCode,
        country: geo.country,
        countryCode: geo.countryCode,
        flag: countryFlag(geo.countryCode),
        region: geo.region,
        regionName: geo.regionName,
        city: geo.city,
        district: geo.district,
        zip: geo.zip,
        lat: geo.lat,
        lon: geo.lon,
        timezone: geo.timezone,
        utcOffset: geo.offset,
        currency: geo.currency,
      } : null,
      network: asInfo ? {
        isp: geo!.isp,
        org: geo!.org,
        asn: asInfo.asn,
        asName: asInfo.asName,
      } : null,
      privacy,
      userAgent: ua,
      languages: langs,
      encoding: enc,
      dnt,
      gpc,
    },
    cloudflare: cf,
    request: {
      method: 'GET',
      url,
      protocol: cf?.scheme || hdrs.get('x-forwarded-proto') || 'http',
      host: hdrs.get('host') || '',
    },
    server: {
      hostname: hostname(),
      port: PORT,
      uptime: Math.floor(uptime / 1000),
      uptimeHuman: formatUptime(uptime),
      runtime: `Node.js ${process.version}`,
      platform: process.platform,
      arch: process.arch,
    },
    headers: flatHeaders(hdrs),
  }
}

export function xesc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
}

export function xel(tag: string, val: string | number | boolean | null): string {
  if (val === null || val === undefined) return `  <${tag} />`
  return `  <${tag}>${xesc(String(val))}</${tag}>`
}

export function buildXml(p: Payload): string {
  const g = p.client.geo
  const n = p.client.network
  const pr = p.client.privacy
  const cf = p.cloudflare
  const hdrs = Object.entries(p.headers).sort(([a], [b]) => a.localeCompare(b))
    .map(([k, v]) => `      <header name="${xesc(k)}">${xesc(v)}</header>`).join('\n')
  const sources = pr.sources.map((s) => `<source>${xesc(s)}</source>`).join('')

  return `<?xml version="1.0" encoding="UTF-8"?>
<response>
  <app>${xesc(p.app)}</app>
  <ferry>${xesc(p.ferry)}</ferry>
  <timestamp>${xesc(p.timestamp)}</timestamp>
  <client>
  ${xel('ip', p.client.ip)}
  ${xel('ipVersion', p.client.ipVersion)}
  ${xel('hostname', p.client.hostname)}
  ${g ? `  <geo>
    ${xel('continent', g.continent)}
    ${xel('continentCode', g.continentCode)}
    ${xel('country', g.country)}
    ${xel('countryCode', g.countryCode)}
    ${xel('flag', g.flag)}
    ${xel('regionName', g.regionName)}
    ${xel('city', g.city)}
    ${xel('district', g.district)}
    ${xel('zip', g.zip)}
    ${xel('lat', g.lat)}
    ${xel('lon', g.lon)}
    ${xel('timezone', g.timezone)}
    ${xel('utcOffset', g.utcOffset)}
    ${xel('currency', g.currency)}
    </geo>` : '  <geo />'}
  ${n ? `  <network>
    ${xel('isp', n.isp)}
    ${xel('org', n.org)}
    ${xel('asn', n.asn)}
    ${xel('asName', n.asName)}
    </network>` : '  <network />'}
    <privacy>
    ${xel('tor', pr.tor)}
    ${xel('vpn', pr.vpn)}
    ${xel('hosting', pr.hosting)}
    ${xel('mobile', pr.mobile)}
    ${xel('residential', pr.residential)}
    ${xel('forwarded', pr.forwarded)}
    ${xel('confidence', pr.confidence)}
    <sources>${sources}</sources>
    </privacy>
    <userAgent>
    ${xel('raw', p.client.userAgent.raw)}
    ${xel('browser', p.client.userAgent.browser)}
    ${xel('browserVersion', p.client.userAgent.browserVersion)}
    ${xel('os', p.client.userAgent.os)}
    ${xel('osVersion', p.client.userAgent.osVersion)}
    ${xel('device', p.client.userAgent.device)}
    ${xel('engine', p.client.userAgent.engine)}
    </userAgent>
    <languages>${p.client.languages.map((l) => `<lang>${xesc(l)}</lang>`).join('')}</languages>
    <encoding>${p.client.encoding.map((e) => `<enc>${xesc(e)}</enc>`).join('')}</encoding>
  ${xel('dnt', p.client.dnt)}
  ${xel('gpc', p.client.gpc)}
  </client>
  ${cf ? `<cloudflare>
  ${xel('detected', true)}
  ${xel('ray', cf.ray)}
  ${xel('datacenter', cf.datacenter)}
  ${xel('datacenterCity', cf.datacenterCity)}
  ${xel('country', cf.country)}
  ${xel('scheme', cf.scheme)}
  </cloudflare>` : '  <cloudflare />'}
  <request>
  ${xel('method', p.request.method)}
  ${xel('url', p.request.url)}
  ${xel('protocol', p.request.protocol)}
  ${xel('host', p.request.host)}
  </request>
  <server>
  ${xel('hostname', p.server.hostname)}
  ${xel('port', p.server.port)}
  ${xel('uptime', p.server.uptime)}
  ${xel('uptimeHuman', p.server.uptimeHuman)}
  ${xel('runtime', p.server.runtime)}
  ${xel('platform', p.server.platform)}
  ${xel('arch', p.server.arch)}
  </server>
  <headers>
${hdrs}
  </headers>
</response>`
}

export function buildText(p: Payload): string {
  const g = p.client.geo
  const n = p.client.network
  const pr = p.client.privacy
  const cf = p.cloudflare
  const ua = p.client.userAgent

  let t = `# ${p.app}\n\n`
  t += `Your IP: ${p.client.ip}\n`
  if (p.client.hostname) t += `Hostname: ${p.client.hostname}\n`
  t += `IP Version: ${p.client.ipVersion}\n`

  if (g) {
    t += `\n## Location\n`
    if (g.continent || g.continentCode) t += `  Continent:   ${g.continent} (${g.continentCode})\n`
    t += `  Country:     ${g.flag} ${g.country} (${g.countryCode})\n`
    if (g.regionName) t += `  Region:      ${g.regionName}\n`
    if (g.city) t += `  City:        ${g.city}\n`
    if (g.district) t += `  District:    ${g.district}\n`
    if (g.zip) t += `  Postal/ZIP:  ${g.zip}\n`
    if (g.lat || g.lon) t += `  Coordinates: ${g.lat}, ${g.lon}\n`
    if (g.timezone) t += `  Timezone:    ${g.timezone} (UTC${g.utcOffset >= 0 ? '+' : ''}${g.utcOffset / 3600})\n`
    if (g.currency) t += `  Currency:    ${g.currency}\n`
  }

  if (n) {
    t += `\n## Network\n`
    t += `  ISP:          ${n.isp}\n`
    if (n.org && n.org !== n.isp) t += `  Organization: ${n.org}\n`
    t += `  AS Number:    ${n.asn}\n`
    if (n.asName) t += `  AS Name:      ${n.asName}\n`
  }

  t += `\n## Privacy\n`
  const connType = pr.tor ? 'Tor exit' : pr.vpn ? 'VPN' : pr.hosting ? 'Datacenter / Hosting' : pr.mobile ? 'Mobile' : pr.residential ? 'Residential' : 'Unclassified'
  t += `  Type:        ${connType}\n`
  t += `  Tor:         ${pr.tor ? 'Yes' : 'No'}\n`
  t += `  VPN:         ${pr.vpn ? 'Yes' : 'No'}\n`
  t += `  Hosting:     ${pr.hosting ? 'Yes' : 'No'}\n`
  t += `  Mobile:      ${pr.mobile ? 'Yes' : 'No'}\n`
  t += `  Residential: ${pr.residential ? 'Yes' : 'No'}\n`
  t += `  Forwarded:   ${pr.forwarded ? 'Yes' : 'No'}\n`
  t += `  Confidence:  ${pr.confidence}\n`
  if (pr.sources.length) t += `  Sources:     ${pr.sources.join(', ')}\n`

  t += `\n## Client\n`
  t += `  Browser:    ${ua.browser}${ua.browserVersion ? ' ' + ua.browserVersion : ''}\n`
  if (ua.engine !== 'Unknown') t += `  Engine:     ${ua.engine}\n`
  t += `  OS:         ${ua.os}${ua.osVersion ? ' ' + ua.osVersion : ''}\n`
  t += `  Device:     ${ua.device}\n`
  if (p.client.languages.length) t += `  Languages:  ${p.client.languages.join(', ')}\n`
  if (p.client.encoding.length) t += `  Encoding:   ${p.client.encoding.join(', ')}\n`
  t += `  DNT:        ${p.client.dnt ? 'Enabled' : 'Disabled'}\n`
  if (p.client.gpc) t += `  GPC:        Enabled\n`
  t += `  User-Agent: ${ua.raw}\n`

  if (cf) {
    t += `\n## Cloudflare\n`
    if (cf.datacenter) t += `  Datacenter: ${cf.datacenter}${cf.datacenterCity ? ' (' + cf.datacenterCity + ')' : ''}\n`
    if (cf.ray) t += `  Ray ID:     ${cf.ray}\n`
    if (cf.country) t += `  Country:    ${countryLabel(cf.country)}\n`
    if (cf.scheme) t += `  Scheme:     ${cf.scheme.toUpperCase()}\n`
  }

  t += `\n## Request\n`
  t += `  Method:    ${p.request.method}\n`
  t += `  URL:       ${p.request.url}\n`
  t += `  Protocol:  ${p.request.protocol.toUpperCase()}\n`
  t += `  Host:      ${p.request.host}\n`
  t += `  Timestamp: ${p.timestamp}\n`

  t += `\n## Server\n`
  t += `  Hostname: ${p.server.hostname}\n`
  t += `  Port:     ${p.server.port}\n`
  t += `  Uptime:   ${p.server.uptimeHuman}\n`
  t += `  Runtime:  ${p.server.runtime}\n`
  t += `  Platform: ${p.server.platform} / ${p.server.arch}\n`

  t += `\n## Headers\n`
  const sorted = Object.entries(p.headers).sort(([a], [b]) => a.localeCompare(b))
  for (const [k, v] of sorted) t += `  ${k}: ${v}\n`

  t += `\n---\nBuilt with ${p.ferry} — https://github.com/gastonmorixe/ferry\nFormats: / | /json | /xml | /text\n`
  return t
}

