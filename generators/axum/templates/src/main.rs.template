const GEO_TTL: Duration = Duration::from_secs(5 * 60);
const GEO_FAIL_TTL: Duration = Duration::from_secs(60);

fn hostname() -> String {
    std::fs::read_to_string("/etc/hostname")
        .unwrap_or_default()
        .trim()
        .to_string()
}

fn html_escape(s: &str) -> String {
    s.replace('&', "&amp;")
        .replace('<', "&lt;")
        .replace('>', "&gt;")
        .replace('"', "&quot;")
}

fn xml_escape(s: &str) -> String {
    html_escape(s)
}

fn country_flag(code: &str) -> String {
    if code.len() != 2 {
        return String::new();
    }
    code.to_uppercase()
        .chars()
        .filter_map(|c| char::from_u32(c as u32 + 127397))
        .collect()
}

fn ip_version(ip: &str) -> &'static str {
    if ip.contains(':') { "IPv6" } else { "IPv4" }
}

fn is_private_ip(ip: &str) -> bool {
    if ip.is_empty() || ip == "unknown" || ip == "::1" || ip == "127.0.0.1" {
        return true;
    }
    if ip.starts_with("10.") || ip.starts_with("192.168.") {
        return true;
    }
    if ip.starts_with("172.") {
        if let Some(oct) = ip.split('.').nth(1).and_then(|s| s.parse::<u8>().ok()) {
            if (16..=31).contains(&oct) {
                return true;
            }
        }
    }
    if ip.starts_with("fc") || ip.starts_with("fd") {
        return true;
    }
    false
}

fn parse_csv_line(line: &str) -> Vec<String> {
    let mut out = Vec::new();
    let mut current = String::new();
    let mut in_quotes = false;
    let chars: Vec<char> = line.chars().collect();
    let mut i = 0;
    while i < chars.len() {
        let ch = chars[i];
        if ch == '"' {
            if in_quotes && i + 1 < chars.len() && chars[i + 1] == '"' {
                current.push('"');
                i += 1;
            } else {
                in_quotes = !in_quotes;
            }
        } else if ch == ',' && !in_quotes {
            out.push(current);
            current = String::new();
        } else {
            current.push(ch);
        }
        i += 1;
    }
    out.push(current);
    out
}

fn ipv4_to_number(ip: &str) -> Option<u32> {
    let normalized = ip.trim_start_matches("::ffff:");
    let parts: Vec<&str> = normalized.split('.').collect();
    if parts.len() != 4 {
        return None;
    }
    let mut out: u32 = 0;
    for part in parts {
        let n: u32 = part.parse().ok()?;
        if n > 255 {
            return None;
        }
        out = (out << 8) | n;
    }
    Some(out)
}

fn continent_name(code: &str) -> String {
    CONTINENT_NAMES
        .iter()
        .find(|(k, _)| *k == code)
        .map(|(_, v)| (*v).to_string())
        .unwrap_or_else(|| code.to_string())
}

fn load_country_meta() -> HashMap<String, CountryMeta> {
    let data = fs::read_to_string(COUNTRY_META_PATH).unwrap_or_else(|_| "{}".to_string());
    serde_json::from_str(&data).unwrap_or_default()
}

fn load_country_ranges() -> Vec<CountryRange> {
    let data = fs::read_to_string(COUNTRY_DB_PATH).unwrap_or_default();
    data.lines()
        .filter_map(|line| {
            if line.trim().is_empty() {
                return None;
            }
            let row = parse_csv_line(line);
            if row.len() < 3 {
                return None;
            }
            Some(CountryRange {
                start: row[0].trim().parse().ok()?,
                end: row[1].trim().parse().ok()?,
                country_code: row[2].trim().to_string(),
            })
        })
        .collect()
}

fn load_asn_ranges() -> Vec<AsnRange> {
    let data = fs::read_to_string(ASN_DB_PATH).unwrap_or_default();
    data.lines()
        .filter_map(|line| {
            if line.trim().is_empty() {
                return None;
            }
            let row = parse_csv_line(line);
            if row.len() < 4 {
                return None;
            }
            Some(AsnRange {
                start: row[0].trim().parse().ok()?,
                end: row[1].trim().parse().ok()?,
                asn: row[2].trim().to_string(),
                org: row[3].trim().to_string(),
            })
        })
        .collect()
}

fn search_country_range(ranges: &[CountryRange], value: u32) -> Option<&CountryRange> {
    let mut low: isize = 0;
    let mut high: isize = ranges.len() as isize - 1;
    while low <= high {
        let mid = ((low + high) / 2) as usize;
        let row = &ranges[mid];
        if value < row.start {
            high = mid as isize - 1;
        } else if value > row.end {
            low = mid as isize + 1;
        } else {
            return Some(row);
        }
    }
    None
}

fn search_asn_range(ranges: &[AsnRange], value: u32) -> Option<&AsnRange> {
    let mut low: isize = 0;
    let mut high: isize = ranges.len() as isize - 1;
    while low <= high {
        let mid = ((low + high) / 2) as usize;
        let row = &ranges[mid];
        if value < row.start {
            high = mid as isize - 1;
        } else if value > row.end {
            low = mid as isize + 1;
        } else {
            return Some(row);
        }
    }
    None
}

async fn fetch_text(client: &reqwest::Client, url: &str) -> Result<String, reqwest::Error> {
    let res = client
        .get(url)
        .header("User-Agent", "ferry-ipdb-updater")
        .header("Accept", "application/json, text/plain, */*")
        .send()
        .await?;
    res.error_for_status()?.text().await
}

async fn fetch_latest_commit_sha(client: &reqwest::Client) -> Option<String> {
    let body = fetch_text(client, IPDB_COMMIT_URL).await.ok()?;
    let parsed: serde_json::Value = serde_json::from_str(&body).ok()?;
    parsed.get("sha")?.as_str().map(|s| s.to_string())
}

fn current_dataset_sha() -> Option<String> {
    let body = fs::read_to_string(DATASET_SOURCE_PATH).ok()?;
    let parsed: serde_json::Value = serde_json::from_str(&body).ok()?;
    parsed
        .get("commit")
        .and_then(|v| v.as_str())
        .or_else(|| parsed.get("sha").and_then(|v| v.as_str()))
        .map(|s| s.to_string())
}

fn write_dataset_source(sha: &str) -> std::io::Result<()> {
    fs::create_dir_all("data")?;
    let payload = serde_json::json!({
        "repo": "https://github.com/sapics/ip-location-db",
        "commit": sha,
        "generatedAt": chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Secs, true),
        "countryDataset": "geo-whois-asn-country",
        "asnDataset": "iptoasn-asn",
    });
    fs::write(
        DATASET_SOURCE_PATH,
        serde_json::to_vec_pretty(&payload).unwrap(),
    )
}

fn country_meta_for(meta_map: &HashMap<String, CountryMeta>, code: &str) -> Option<CountryLookup> {
    if code.is_empty() {
        return None;
    }
    let meta = meta_map.get(code)?;
    Some(CountryLookup {
        continent: continent_name(&meta.continent),
        continent_code: meta.continent.clone(),
        country: if meta.name.is_empty() {
            code.to_string()
        } else {
            meta.name.clone()
        },
        currency: meta.currency.clone(),
    })
}

