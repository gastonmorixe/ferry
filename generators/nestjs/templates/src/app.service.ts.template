]

const MOBILE_ORG_PATTERNS = [
  /mobile/i, /wireless/i, /cell/i, /telecom/i, /telefonica/i, /vodafone/i,
  /orange/i, /verizon/i, /airtel/i, /mtn/i, /telstra/i, /singtel/i,
]

const START_TIME = Date.now()
const APP_NAME = '{{APP_NAME}}'
const PORT = Number(process.env.PORT) || {{APP_PORT}}

let countryMeta: Record<string, CountryMeta> | null = null
let countryRanges: CountryRange[] | null = null
let asnRanges: AsnRange[] | null = null
let datasetsReady = false
let datasetLoadPromise: Promise<void> | null = null

function isPrivateIp(ip: string): boolean {
  if (!ip || ip === 'unknown' || ip === '::1' || ip === '127.0.0.1') return true
  const normalized = ip.replace(/^::ffff:/, '')
  if (normalized !== ip) ip = normalized
  if (ip.startsWith('10.') || ip.startsWith('192.168.')) return true
  if (ip.startsWith('172.')) {
    const oct = parseInt(ip.split('.')[1], 10)
    if (oct >= 16 && oct <= 31) return true
  }
  if (ip.startsWith('fc') || ip.startsWith('fd')) return true
  return false
}

function parseCsvLine(line: string): string[] {
  const out: string[] = []
  let current = ''
  let inQuotes = false
  for (let i = 0; i < line.length; i += 1) {
    const ch = line[i]
    if (ch === '"') {
      if (inQuotes && line[i + 1] === '"') {
        current += '"'
        i += 1
      } else {
        inQuotes = !inQuotes
      }
    } else if (ch === ',' && !inQuotes) {
      out.push(current)
      current = ''
    } else {
      current += ch
    }
  }
  out.push(current)
  return out
}

function ipv4ToNumber(ip: string): number | null {
  const normalized = ip.replace(/^::ffff:/, '')
  if (!/^\d+\.\d+\.\d+\.\d+$/.test(normalized)) return null
  const parts = normalized.split('.').map((part) => Number(part))
  if (parts.length !== 4 || parts.some((part) => !Number.isInteger(part) || part < 0 || part > 255)) return null
  return (((parts[0] * 256 + parts[1]) * 256 + parts[2]) * 256 + parts[3]) >>> 0
}

function loadCountryMeta(): Record<string, CountryMeta> {
  if (!countryMeta) {
    countryMeta = JSON.parse(fs.readFileSync(COUNTRY_META_PATH, 'utf8')) as Record<string, CountryMeta>
  }
  return countryMeta
}

function loadCountryRanges(): CountryRange[] {
  if (!countryRanges) {
    const lines = fs.readFileSync(COUNTRY_DB_PATH, 'utf8').split(/\r?\n/).filter(Boolean)
    countryRanges = lines.map((line) => {
      const [start, end, countryCode] = parseCsvLine(line)
      return { start: Number(start), end: Number(end), countryCode }
    })
  }
  return countryRanges
}

function loadAsnRanges(): AsnRange[] {
  if (!asnRanges) {
    const lines = fs.readFileSync(ASN_DB_PATH, 'utf8').split(/\r?\n/).filter(Boolean)
    asnRanges = lines.map((line) => {
      const [start, end, asn, org] = parseCsvLine(line)
      return { start: Number(start), end: Number(end), asn, org }
    })
  }
  return asnRanges
}

function searchRange<T extends { start: number; end: number }>(ranges: T[], value: number): T | null {
  let low = 0
  let high = ranges.length - 1
  while (low <= high) {
    const mid = (low + high) >> 1
    const row = ranges[mid]
    if (value < row.start) high = mid - 1
    else if (value > row.end) low = mid + 1
    else return row
  }
  return null
}

async function fetchText(url: string): Promise<string> {
  const ctrl = new AbortController()
  const timer = setTimeout(() => ctrl.abort(), IPDB_TIMEOUT_MS)
  try {
    const res = await fetch(url, {
      signal: ctrl.signal,
      headers: {
        'User-Agent': `${APP_NAME}/ferry-ipdb-updater`,
        'Accept': 'application/json, text/plain, */*',
      },
    })
    if (!res.ok) throw new Error(`HTTP ${res.status}`)
    return await res.text()
  } finally {
    clearTimeout(timer)
  }
}

async function fetchLatestCommitSha(): Promise<string | null> {
  try {
    const parsed = JSON.parse(await fetchText(IPDB_COMMIT_URL)) as { sha?: string }
    return parsed.sha || null
  } catch {
    return null
  }
}

function currentDatasetSha(): string | null {
  try {
    const parsed = JSON.parse(fs.readFileSync(DATASET_SOURCE_PATH, 'utf8')) as { commit?: string }
    return parsed.commit || null
  } catch {
    return null
  }
}

function writeDatasetSource(sha: string): void {
  fs.mkdirSync(path.dirname(DATASET_SOURCE_PATH), { recursive: true })
  fs.writeFileSync(DATASET_SOURCE_PATH, JSON.stringify({
    repo: 'https://github.com/sapics/ip-location-db',
    commit: sha,
    generatedAt: new Date().toISOString(),
    countryDataset: 'geo-whois-asn-country',
    asnDataset: 'iptoasn-asn',
  }), 'utf8')
}

async function refreshDatasetsIfNeeded(force = false): Promise<void> {
  if (datasetLoadPromise) return datasetLoadPromise
  datasetLoadPromise = (async () => {
    if (!force) ensureDatasetsLoaded()
    const currentSha = currentDatasetSha()
    const latestSha = await fetchLatestCommitSha()
    if (!latestSha || latestSha === currentSha) return

    const [countryCsv, asnCsv] = await Promise.all([
      fetchText(IPDB_COUNTRY_URL),
      fetchText(IPDB_ASN_URL),
    ])

    fs.mkdirSync(path.dirname(COUNTRY_DB_PATH), { recursive: true })
    fs.writeFileSync(`${COUNTRY_DB_PATH}.tmp`, countryCsv, 'utf8')
    fs.writeFileSync(`${ASN_DB_PATH}.tmp`, asnCsv, 'utf8')
    fs.renameSync(`${COUNTRY_DB_PATH}.tmp`, COUNTRY_DB_PATH)
    fs.renameSync(`${ASN_DB_PATH}.tmp`, ASN_DB_PATH)
    writeDatasetSource(latestSha)

    countryRanges = null
    asnRanges = null
    datasetsReady = false
    geoCache.clear()
    ensureDatasetsLoaded()
  })().finally(() => {
    datasetLoadPromise = null
  })
  return datasetLoadPromise
}

function ensureDatasetsLoaded(): void {
  if (datasetsReady) return
  if (!fs.existsSync(COUNTRY_DB_PATH) || !fs.existsSync(ASN_DB_PATH)) {
    throw new Error('Missing local IP datasets under ./data')
  }
  loadCountryRanges()
  loadAsnRanges()
  datasetsReady = true
}

function countryMetaFor(code: string | null): { continent: string; continentCode: string; country: string; currency: string } | null {
  if (!code) return null
  const meta = loadCountryMeta()[code]
  return {
    continent: meta?.continent ? (CONTINENT_NAMES[meta.continent] || meta.continent) : '',
    continentCode: meta?.continent || '',
    country: meta?.name || code,
    currency: meta?.currency || '',
  }
}

function isHostingOrg(org: string): boolean {
  return HOSTING_ORG_PATTERNS.some((pattern) => pattern.test(org))
}

function isMobileOrg(org: string): boolean {
  return MOBILE_ORG_PATTERNS.some((pattern) => pattern.test(org))
}

async function lookupHostname(ip: string): Promise<string | null> {
  if (!ip || isPrivateIp(ip)) return null
  try {
    const names = await Promise.race([
      dns.promises.reverse(ip.replace(/^::ffff:/, '')),
      new Promise<string[]>((_, reject) => setTimeout(() => reject(new Error('timeout')), 1200)),
    ])
    return names[0] || null
  } catch {
    return null
  }
}

async function lookupGeo(ip: string, fallbackCountry: string | null): Promise<GeoData | null> {
  const cacheKey = `${ip}:${fallbackCountry || ''}`
  const cached = geoCache.get(cacheKey)
  if (cached && cached.exp > Date.now()) return cached.data

  try {
    ensureDatasetsLoaded()
    void refreshDatasetsIfNeeded().catch(() => {})
    const ipNum = ipv4ToNumber(ip)
    const countryRow = ipNum === null ? null : searchRange(loadCountryRanges(), ipNum)
    const asnRow = ipNum === null ? null : searchRange(loadAsnRanges(), ipNum)
    const countryCode = countryRow?.countryCode || fallbackCountry || ''
    const meta = countryMetaFor(countryCode)
    const reverse = await lookupHostname(ip)

    const data = (countryCode || asnRow) ? {
      continent: meta?.continent || '',
      continentCode: meta?.continentCode || '',
      country: meta?.country || countryCode,
      countryCode,
      region: '',
      regionName: '',
      city: '',
      district: '',
      zip: '',
      lat: 0,
      lon: 0,
      timezone: '',
      offset: 0,
      currency: meta?.currency || '',
      isp: asnRow?.org || '',
      org: asnRow?.org || '',
      as: asnRow ? `AS${asnRow.asn}` : '',
      asname: asnRow?.org || '',
      reverse: reverse || '',
      mobile: isMobileOrg(asnRow?.org || ''),
      proxy: false,
      hosting: isHostingOrg(asnRow?.org || ''),
      query: ip,
    } satisfies GeoData : null

    geoCache.set(cacheKey, { data, exp: Date.now() + GEO_TTL })
    return data
  } catch {
    geoCache.set(cacheKey, { data: null, exp: Date.now() + GEO_FAIL_TTL })
    return null
  }
}

// ── User-Agent Parser ───────────────────────────────────────────────────────

function parseUA(raw: string): UaInfo {
  const r: UaInfo = { raw, browser: 'Unknown', browserVersion: '', os: 'Unknown', osVersion: '', device: 'Unknown', engine: 'Unknown' }
  if (!raw) return r

  const b: [RegExp, string][] = [
    [/Edg(?:e|A|iOS)?\/(\S+)/i, 'Edge'],
    [/OPR\/(\S+)/i, 'Opera'],
    [/Vivaldi\/(\S+)/i, 'Vivaldi'],
    [/Brave\/(\S+)/i, 'Brave'],
    [/Firefox\/(\S+)/i, 'Firefox'],
    [/SamsungBrowser\/(\S+)/i, 'Samsung Internet'],
    [/UCBrowser\/(\S+)/i, 'UC Browser'],
    [/Chrome\/(\S+)/i, 'Chrome'],
    [/Version\/(\S+).*Safari/i, 'Safari'],
    [/curl\/(\S+)/i, 'curl'],
    [/Wget\/(\S+)/i, 'Wget'],
    [/HTTPie\/(\S+)/i, 'HTTPie'],
    [/Claude-User/i, 'Claude'],
  ]
  for (const [re, name] of b) {
    const m = raw.match(re)
    if (m) { r.browser = name; r.browserVersion = m[1] || ''; break }
  }
  if (r.browser === 'Unknown' && /bot|crawl|spider|slurp|feed|index/i.test(raw)) r.browser = 'Bot'

  if (/Trident/i.test(raw)) r.engine = 'Trident'
  else if (/Gecko\/\d/i.test(raw) && !/like Gecko/i.test(raw.split('Gecko')[0] || '')) r.engine = 'Gecko'
  if (/AppleWebKit/i.test(raw)) r.engine = 'WebKit'
  if (r.browser === 'Chrome' || r.browser === 'Edge' || r.browser === 'Opera' || r.browser === 'Vivaldi' || r.browser === 'Brave') r.engine = 'Blink'

  if (/Windows NT ([\d.]+)/i.test(raw)) {
    r.os = 'Windows'; const v = RegExp.$1
    r.osVersion = ({ '10.0': '10+', '6.3': '8.1', '6.2': '8', '6.1': '7', '6.0': 'Vista' } as any)[v] || v
  } else if (/Mac OS X ([\d._]+)/i.test(raw)) { r.os = 'macOS'; r.osVersion = RegExp.$1.replace(/_/g, '.') }
  else if (/CrOS/i.test(raw)) r.os = 'ChromeOS'
  else if (/Android ([\d.]+)/i.test(raw)) { r.os = 'Android'; r.osVersion = RegExp.$1 }
  else if (/iPhone OS ([\d_]+)/i.test(raw)) { r.os = 'iOS'; r.osVersion = RegExp.$1.replace(/_/g, '.') }
  else if (/iPad.*OS ([\d_]+)/i.test(raw)) { r.os = 'iPadOS'; r.osVersion = RegExp.$1.replace(/_/g, '.') }
  else if (/Linux/i.test(raw)) r.os = 'Linux'
  else if (/FreeBSD/i.test(raw)) r.os = 'FreeBSD'

  if (/Mobile|Android.*Mobile|iPhone|iPod/i.test(raw)) r.device = 'Mobile'
  else if (/iPad|Android(?!.*Mobile)|Tablet/i.test(raw)) r.device = 'Tablet'
  else if (/Smart-?TV|Tizen|Web0S|NetCast/i.test(raw)) r.device = 'Smart TV'
  else if (/bot|crawl|spider/i.test(raw)) r.device = 'Bot'
  else if (/curl|wget|httpie|python-requests|go-http|java\//i.test(raw)) r.device = 'CLI / Library'
  else r.device = 'Desktop'

  return r
}

// ── Helpers ─────────────────────────────────────────────────────────────────

function countryFlag(code: string): string {
  if (!code || code.length !== 2) return ''
  return String.fromCodePoint(code.toUpperCase().charCodeAt(0) + 127397, code.toUpperCase().charCodeAt(1) + 127397)
}

function countryLabel(code: string | null): string {
  if (!code) return ''
  const meta = countryMetaFor(code)
  const name = meta?.country || code
  return `${countryFlag(code)} ${name}${name !== code ? ` (${code})` : ''}`
}

function ipVersion(ip: string): string {
  return ip.includes(':') ? 'IPv6' : 'IPv4'
}

function getClientIp(req: Request): string {
  return (
    (req.headers['cf-connecting-ip'] as string) ||
    (req.headers['true-client-ip'] as string) ||
    (req.headers['x-real-ip'] as string) ||
    ((req.headers['x-forwarded-for'] as string) || '').split(',')[0].trim() ||
    req.ip ||
    req.socket.remoteAddress ||
    'unknown'
  )
}

function getCfInfo(req: Request): Payload['cloudflare'] {
  const ray = req.headers['cf-ray'] as string | undefined
  if (!ray) return null

  let dcCode: string | null = null
  let dcCity: string | null = null
  const dash = ray.lastIndexOf('-')
  if (dash > 0) {
    dcCode = ray.slice(dash + 1)
    dcCity = CF_DC[dcCode] || null
  }

  let scheme: string | null = null
  try { scheme = JSON.parse((req.headers['cf-visitor'] as string) || '{}').scheme || null } catch {}

  return {
    detected: true,
    ray: dash > 0 ? ray.slice(0, dash) : ray,
    datacenter: dcCode,
    datacenterCity: dcCity,
    country: (req.headers['cf-ipcountry'] as string) || null,
    scheme,
    warp: !!req.headers['cf-warp-tag-id'],
  }
}

function parseAs(as: string): { asn: string; asName: string } {
  const m = as.match(/^(AS\d+)\s*(.*)/)
  return m ? { asn: m[1], asName: m[2] } : { asn: as, asName: '' }
}

function formatUptime(ms: number): string {
  const s = Math.floor(ms / 1000)
  const d = Math.floor(s / 86400)
  const h = Math.floor((s % 86400) / 3600)
  const m = Math.floor((s % 3600) / 60)
  const sec = s % 60
  if (d > 0) return `${d}d ${h}h ${m}m`
  if (h > 0) return `${h}h ${m}m ${sec}s`
  if (m > 0) return `${m}m ${sec}s`
  return `${sec}s`
}

function flatHeaders(req: Request): Record<string, string> {
  const out: Record<string, string> = {}
  for (const [k, v] of Object.entries(req.headers)) {
    out[k] = Array.isArray(v) ? v.join(', ') : (v ?? '')
  }
  return out
}

function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
}

function xesc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
}

function xel(tag: string, val: string | number | boolean | null): string {
  if (val === null || val === undefined) return `  <${tag} />`
  return `  <${tag}>${xesc(String(val))}</${tag}>`
}

function hasProxySignal(req: Request, cf: Payload['cloudflare']): boolean {
  const hopCount = ((req.headers['x-forwarded-for'] as string) || '')
    .split(',')
    .map((part) => part.trim())
    .filter(Boolean).length
  return Boolean(
    req.headers['via']
    || req.headers['proxy-connection']
    || req.headers['forwarded']
    || hopCount > 1
    || cf?.warp,
  )
}

function buildPrivacy(req: Request, geo: GeoData | null, ua: UaInfo, cf: Payload['cloudflare']): Payload['client']['privacy'] {
  const proxy = hasProxySignal(req, cf)
  const hosting = geo?.hosting || false
  const mobile = geo?.mobile || (ua.device === 'Mobile' && isMobileOrg(geo?.org || ''))
  if (!proxy && !hosting && !mobile) return null
  return { proxy, hosting, mobile }
}

// ── Service ─────────────────────────────────────────────────────────────────

@Injectable()
export class AppService {
  async buildPayload(req: Request): Promise<Payload> {
    const ip = getClientIp(req)
    const cf = getCfInfo(req)
    const geo = await lookupGeo(ip, cf?.country || null)
    const ua = parseUA((req.headers['user-agent'] as string) || '')

    const langs = ((req.headers['accept-language'] as string) || '')
      .split(',').map(l => l.split(';')[0].trim()).filter(Boolean)

    const enc = ((req.headers['accept-encoding'] as string) || '')
      .split(',').map(e => e.trim()).filter(Boolean)

    const dnt = req.headers['dnt'] === '1'
    const gpc = req.headers['sec-gpc'] === '1'

    const uptime = Date.now() - START_TIME
    const asInfo = geo?.as ? parseAs(geo.as) : null
    const privacy = buildPrivacy(req, geo, ua, cf)

    return {
      app: APP_NAME,
      ferry: '⛵ Ferry v{{FERRY_VERSION}}',
      timestamp: new Date().toISOString(),
      client: {
        ip,
        ipVersion: ipVersion(ip),
        hostname: geo?.reverse || null,
        geo: geo ? {
          continent: geo.continent,
          continentCode: geo.continentCode,
          country: geo.country,
          countryCode: geo.countryCode,
          flag: countryFlag(geo.countryCode),
          region: geo.region,
          regionName: geo.regionName,
          city: geo.city,
          district: geo.district,
          zip: geo.zip,
          lat: geo.lat,
          lon: geo.lon,
          timezone: geo.timezone,
          utcOffset: geo.offset,
          currency: geo.currency,
        } : null,
        network: asInfo ? {
          isp: geo!.isp,
          org: geo!.org,
          asn: asInfo.asn,
          asName: asInfo.asName,
        } : null,
        privacy,
        userAgent: ua,
        languages: langs,
        encoding: enc,
        dnt,
        gpc,
      },
      cloudflare: cf,
      request: {
        method: req.method,
        url: req.originalUrl,
        protocol: cf?.scheme || req.protocol,
        host: (req.headers['host'] as string) || '',
      },
      server: {
        hostname: hostname(),
        port: PORT,
        uptime: Math.floor(uptime / 1000),
        uptimeHuman: formatUptime(uptime),
        runtime: `Node.js ${process.version}`,
        platform: process.platform,
        arch: process.arch,
      },
      headers: flatHeaders(req),
    }
  }

  // ── HTML Renderer ─────────────────────────────────────────────────────────

  renderHtml(p: Payload): string {
    const g = p.client.geo
    const n = p.client.network
    const pr = p.client.privacy
    const cf = p.cloudflare
    const ua = p.client.userAgent

    const row = (label: string, value: string, cls?: string): string =>
      `<tr><td>${esc(label)}</td><td${cls ? ` class="${cls}"` : ''}>${value}</td></tr>`

    const bdg = (text: string, color: string): string =>
      `<span class="badge badge-${color}">${esc(text)}</span>`

    // Hero
    const heroLocation = g
      ? `<span class="ip-flag">${g.flag}</span> ${esc(g.city || g.regionName || g.country)}${g.city && g.country ? `, ${esc(g.country)}` : ''}`
      : (cf?.country ? countryLabel(cf.country) : '')
    const heroHostname = p.client.hostname
      ? `<div class="ip-hostname">${esc(p.client.hostname)}</div>` : ''

    // Location section
    let locationRows = ''
    if (g) {
      if (g.continent || g.continentCode) locationRows += row('Continent', `${esc(g.continent)} (${esc(g.continentCode)})`)
      locationRows += row('Country', `${g.flag} ${esc(g.country)} (${esc(g.countryCode)})`)
      if (g.regionName) locationRows += row('Region', esc(g.regionName))
      if (g.city) locationRows += row('City', esc(g.city))
      if (g.district) locationRows += row('District', esc(g.district))
      if (g.zip) locationRows += row('Postal / ZIP', esc(g.zip))
      if (g.lat || g.lon) {
        locationRows += row('Coordinates',
          `<a class="coord-link" href="https://www.openstreetmap.org/?mlat=${g.lat}&mlon=${g.lon}#map=12/${g.lat}/${g.lon}" target="_blank" rel="noopener">${g.lat}, ${g.lon}</a>`)
      }
      if (g.timezone) locationRows += row('Timezone', `${esc(g.timezone)} (UTC${g.utcOffset >= 0 ? '+' : ''}${g.utcOffset / 3600})`)
      if (g.currency) locationRows += row('Currency', esc(g.currency))
    }

    // Network section
    let networkRows = ''
    if (n) {
      networkRows += row('ISP', esc(n.isp))
      if (n.org && n.org !== n.isp) networkRows += row('Organization', esc(n.org))
      networkRows += row('AS Number', `<span class="mono">${esc(n.asn)}</span>`)
      if (n.asName) networkRows += row('AS Name', esc(n.asName))
    }
    networkRows += row('IP Version', esc(p.client.ipVersion))
    if (p.client.hostname) networkRows += row('Reverse DNS', `<span class="mono">${esc(p.client.hostname)}</span>`)

    // Privacy section
    let privacyRows = ''
    if (pr) {
      const connType = pr.hosting ? 'Datacenter / Hosting' : pr.mobile ? 'Mobile Network' : 'Residential'
      const connColor = pr.hosting ? 'yellow' : pr.mobile ? 'blue' : 'green'
      privacyRows += row('Connection Type', bdg(connType, connColor))
      privacyRows += row('Proxy / VPN', pr.proxy ? bdg('Detected', 'red') : bdg('Not Detected', 'green'))
      privacyRows += row('Hosting / DC', pr.hosting ? bdg('Yes', 'yellow') : bdg('No', 'green'))
      privacyRows += row('Mobile Network', pr.mobile ? bdg('Yes', 'blue') : bdg('No', 'gray'))
    }

    // Client section
    let clientRows = ''
    clientRows += row('Browser', ua.browser !== 'Unknown' ? `${esc(ua.browser)}${ua.browserVersion ? ' ' + esc(ua.browserVersion) : ''}` : `<span class="unavailable">${esc(ua.raw.slice(0, 80))}${ua.raw.length > 80 ? '...' : ''}</span>`)
    if (ua.engine !== 'Unknown') clientRows += row('Engine', esc(ua.engine))
    clientRows += row('OS', ua.os !== 'Unknown' ? `${esc(ua.os)}${ua.osVersion ? ' ' + esc(ua.osVersion) : ''}` : '<span class="unavailable">Unknown</span>')
    clientRows += row('Device', esc(ua.device))
    if (p.client.languages.length) clientRows += row('Languages', esc(p.client.languages.join(', ')))
    if (p.client.encoding.length) clientRows += row('Encoding', esc(p.client.encoding.join(', ')))
    clientRows += row('Do Not Track', p.client.dnt ? bdg('Enabled', 'green') : bdg('Disabled', 'gray'))
    if (p.client.gpc) clientRows += row('Global Privacy', bdg('Enabled', 'green'))

    // Cloudflare section
    let cfSection = ''
    if (cf) {
      let cfRows = ''
      if (cf.datacenter) cfRows += row('Datacenter', `<span class="mono">${esc(cf.datacenter)}</span>${cf.datacenterCity ? ' — ' + esc(cf.datacenterCity) : ''}`)
      if (cf.ray) cfRows += row('Ray ID', `<span class="mono">${esc(cf.ray)}</span>`)
      if (cf.country) cfRows += row('Country', esc(countryLabel(cf.country)))
      if (cf.scheme) cfRows += row('Scheme', esc(cf.scheme.toUpperCase()))
      cfRows += row('WARP', cf.warp ? bdg('Active', 'purple') : bdg('Inactive', 'gray'))
      cfSection = `<h2>Cloudflare</h2><table><tbody>${cfRows}</tbody></table>
    <p class="section-note">Request proxied through Cloudflare — client TLS terminates at the edge</p>`
    }

    // Request section
    const reqRows = row('Method', `<span class="mono">${esc(p.request.method)}</span>`)
      + row('URL', `<span class="mono">${esc(p.request.url)}</span>`)
      + row('Protocol', esc(p.request.protocol.toUpperCase()))
      + row('Host', esc(p.request.host))
      + row('Timestamp', `<span class="mono">${esc(p.timestamp)}</span>`)

    // Server section
    const srvRows = row('Hostname', `<span class="mono">${esc(p.server.hostname)}</span>`)
      + row('Port', String(p.server.port))
      + row('Uptime', esc(p.server.uptimeHuman))
      + row('Runtime', esc(p.server.runtime))
      + row('Platform', `${esc(p.server.platform)} / ${esc(p.server.arch)}`)

    // Headers
    const sortedHeaders = Object.entries(p.headers).sort(([a], [b]) => a.localeCompare(b))
    const headerRows = sortedHeaders.map(([k, v]) =>
      `<tr><td>${esc(k)}</td><td class="mono">${esc(v)}</td></tr>`).join('\n')

    return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${esc(APP_NAME)}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>${esc(APP_NAME)}</h1>
    <p class="subtitle">Built with <a href="https://github.com/gastonmorixe/ferry" target="_blank" rel="noopener">⛵ Ferry</a></p>

    <div class="ip-hero">
      <div class="ip-label">Your IP Address</div>
      <div class="ip-address">${esc(p.client.ip)}</div>
      ${heroLocation ? `<div class="ip-meta">${heroLocation}</div>` : ''}
      ${heroHostname}
    </div>

    ${g ? `<h2>Location</h2>
    <table><tbody>${locationRows}</tbody></table>` : ''}

    ${networkRows ? `<h2>Network</h2>
    <table><tbody>${networkRows}</tbody></table>` : ''}

    ${pr ? `<h2>Privacy &amp; Security</h2>
    <table><tbody>${privacyRows}</tbody></table>` : ''}

    <h2>Client</h2>
    <table><tbody>${clientRows}</tbody></table>

    ${cfSection}

    <h2>Request</h2>
    <table><tbody>${reqRows}</tbody></table>

    <h2>Server</h2>
    <table><tbody>${srvRows}</tbody></table>

    <details>
      <summary>Headers <span class="count">(${sortedHeaders.length})</span></summary>
      <table><tbody>
        ${headerRows}
      </tbody></table>
    </details>

    <div class="formats">
      <a class="active" href="/">HTML</a>
      <a href="/json">JSON</a>
      <a href="/xml">XML</a>
      <a href="/text">Text</a>
    </div>

    <footer>Built with <a href="https://github.com/gastonmorixe/ferry" target="_blank" rel="noopener">⛵ Ferry</a></footer>
  </div>
</body>
</html>`
  }

  // ── XML Renderer ──────────────────────────────────────────────────────────

  renderXml(p: Payload): string {
    const g = p.client.geo
    const n = p.client.network
    const pr = p.client.privacy
    const cf = p.cloudflare
    const hdrs = Object.entries(p.headers).sort(([a], [b]) => a.localeCompare(b))
      .map(([k, v]) => `      <header name="${xesc(k)}">${xesc(v)}</header>`).join('\n')

    return `<?xml version="1.0" encoding="UTF-8"?>
<response>
  <app>${xesc(p.app)}</app>
  <ferry>${xesc(p.ferry)}</ferry>
  <timestamp>${xesc(p.timestamp)}</timestamp>
  <client>
  ${xel('ip', p.client.ip)}
  ${xel('ipVersion', p.client.ipVersion)}
  ${xel('hostname', p.client.hostname)}
  ${g ? `  <geo>
    ${xel('continent', g.continent)}
    ${xel('continentCode', g.continentCode)}
    ${xel('country', g.country)}
    ${xel('countryCode', g.countryCode)}
    ${xel('flag', g.flag)}
    ${xel('regionName', g.regionName)}
    ${xel('city', g.city)}
    ${xel('district', g.district)}
    ${xel('zip', g.zip)}
    ${xel('lat', g.lat)}
    ${xel('lon', g.lon)}
    ${xel('timezone', g.timezone)}
    ${xel('utcOffset', g.utcOffset)}
    ${xel('currency', g.currency)}
    </geo>` : '  <geo />'}
  ${n ? `  <network>
    ${xel('isp', n.isp)}
    ${xel('org', n.org)}
    ${xel('asn', n.asn)}
    ${xel('asName', n.asName)}
    </network>` : '  <network />'}
  ${pr ? `  <privacy>
    ${xel('proxy', pr.proxy)}
    ${xel('hosting', pr.hosting)}
    ${xel('mobile', pr.mobile)}
    </privacy>` : '  <privacy />'}
    <userAgent>
    ${xel('raw', p.client.userAgent.raw)}
    ${xel('browser', p.client.userAgent.browser)}
    ${xel('browserVersion', p.client.userAgent.browserVersion)}
    ${xel('os', p.client.userAgent.os)}
    ${xel('osVersion', p.client.userAgent.osVersion)}
    ${xel('device', p.client.userAgent.device)}
    ${xel('engine', p.client.userAgent.engine)}
    </userAgent>
    <languages>${p.client.languages.map(l => `<lang>${xesc(l)}</lang>`).join('')}</languages>
    <encoding>${p.client.encoding.map(e => `<enc>${xesc(e)}</enc>`).join('')}</encoding>
  ${xel('dnt', p.client.dnt)}
  ${xel('gpc', p.client.gpc)}
  </client>
  ${cf ? `<cloudflare>
  ${xel('detected', true)}
  ${xel('ray', cf.ray)}
  ${xel('datacenter', cf.datacenter)}
  ${xel('datacenterCity', cf.datacenterCity)}
  ${xel('country', cf.country)}
  ${xel('scheme', cf.scheme)}
  ${xel('warp', cf.warp)}
  </cloudflare>` : '  <cloudflare />'}
  <request>
  ${xel('method', p.request.method)}
  ${xel('url', p.request.url)}
  ${xel('protocol', p.request.protocol)}
  ${xel('host', p.request.host)}
  </request>
  <server>
  ${xel('hostname', p.server.hostname)}
  ${xel('port', p.server.port)}
  ${xel('uptime', p.server.uptime)}
  ${xel('uptimeHuman', p.server.uptimeHuman)}
  ${xel('runtime', p.server.runtime)}
  ${xel('platform', p.server.platform)}
  ${xel('arch', p.server.arch)}
  </server>
  <headers>
${hdrs}
  </headers>
</response>`
  }

  // ── Text Renderer ─────────────────────────────────────────────────────────

  renderText(p: Payload): string {
    const g = p.client.geo
    const n = p.client.network
    const pr = p.client.privacy
    const cf = p.cloudflare
    const ua = p.client.userAgent

    let t = `# ${p.app}\n\n`
    t += `Your IP: ${p.client.ip}\n`
    if (p.client.hostname) t += `Hostname: ${p.client.hostname}\n`
    t += `IP Version: ${p.client.ipVersion}\n`

    if (g) {
      t += `\n## Location\n`
      if (g.continent || g.continentCode) t += `  Continent:   ${g.continent} (${g.continentCode})\n`
      t += `  Country:     ${g.flag} ${g.country} (${g.countryCode})\n`
      if (g.regionName) t += `  Region:      ${g.regionName}\n`
      if (g.city) t += `  City:        ${g.city}\n`
      if (g.district) t += `  District:    ${g.district}\n`
      if (g.zip) t += `  Postal/ZIP:  ${g.zip}\n`
      if (g.lat || g.lon) t += `  Coordinates: ${g.lat}, ${g.lon}\n`
      if (g.timezone) t += `  Timezone:    ${g.timezone} (UTC${g.utcOffset >= 0 ? '+' : ''}${g.utcOffset / 3600})\n`
      if (g.currency) t += `  Currency:    ${g.currency}\n`
    }

    if (n) {
      t += `\n## Network\n`
      t += `  ISP:          ${n.isp}\n`
      if (n.org && n.org !== n.isp) t += `  Organization: ${n.org}\n`
      t += `  AS Number:    ${n.asn}\n`
      if (n.asName) t += `  AS Name:      ${n.asName}\n`
    }

    if (pr) {
      t += `\n## Privacy\n`
      const connType = pr.hosting ? 'Datacenter / Hosting' : pr.mobile ? 'Mobile Network' : 'Residential'
      t += `  Type:     ${connType}\n`
      t += `  Proxy:    ${pr.proxy ? 'Detected' : 'Not detected'}\n`
      t += `  Hosting:  ${pr.hosting ? 'Yes' : 'No'}\n`
      t += `  Mobile:   ${pr.mobile ? 'Yes' : 'No'}\n`
    }

    t += `\n## Client\n`
    t += `  Browser:    ${ua.browser}${ua.browserVersion ? ' ' + ua.browserVersion : ''}\n`
    if (ua.engine !== 'Unknown') t += `  Engine:     ${ua.engine}\n`
    t += `  OS:         ${ua.os}${ua.osVersion ? ' ' + ua.osVersion : ''}\n`
    t += `  Device:     ${ua.device}\n`
    if (p.client.languages.length) t += `  Languages:  ${p.client.languages.join(', ')}\n`
    if (p.client.encoding.length) t += `  Encoding:   ${p.client.encoding.join(', ')}\n`
    t += `  DNT:        ${p.client.dnt ? 'Enabled' : 'Disabled'}\n`
    if (p.client.gpc) t += `  GPC:        Enabled\n`
    t += `  User-Agent: ${ua.raw}\n`

    if (cf) {
      t += `\n## Cloudflare\n`
      if (cf.datacenter) t += `  Datacenter: ${cf.datacenter}${cf.datacenterCity ? ' (' + cf.datacenterCity + ')' : ''}\n`
      if (cf.ray) t += `  Ray ID:     ${cf.ray}\n`
      if (cf.country) t += `  Country:    ${countryLabel(cf.country)}\n`
      if (cf.scheme) t += `  Scheme:     ${cf.scheme.toUpperCase()}\n`
      t += `  WARP:       ${cf.warp ? 'Active' : 'Inactive'}\n`
    }

    t += `\n## Request\n`
    t += `  Method:    ${p.request.method}\n`
    t += `  URL:       ${p.request.url}\n`
    t += `  Protocol:  ${p.request.protocol.toUpperCase()}\n`
    t += `  Host:      ${p.request.host}\n`
    t += `  Timestamp: ${p.timestamp}\n`

    t += `\n## Server\n`
    t += `  Hostname: ${p.server.hostname}\n`
    t += `  Port:     ${p.server.port}\n`
    t += `  Uptime:   ${p.server.uptimeHuman}\n`
    t += `  Runtime:  ${p.server.runtime}\n`
    t += `  Platform: ${p.server.platform} / ${p.server.arch}\n`

    t += `\n## Headers\n`
    const sorted = Object.entries(p.headers).sort(([a], [b]) => a.localeCompare(b))
    for (const [k, v] of sorted) t += `  ${k}: ${v}\n`

    t += `\n---\nBuilt with ${p.ferry} — https://github.com/gastonmorixe/ferry\nFormats: / | /json | /xml | /text\n`
    return t
  }
}

void refreshDatasetsIfNeeded(true).catch(() => {})
setInterval(() => {
  void refreshDatasetsIfNeeded(true).catch(() => {})
}, IPDB_REFRESH_MS)
