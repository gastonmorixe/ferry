/* Embedded from generators/_shared/assets/style.css */
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Oxygen,Ubuntu,sans-serif;background:#0f1117;color:#c9d1d9;min-height:100vh;display:flex;justify-content:center;padding:2rem 1rem}
.container{max-width:740px;width:100%}
h1{font-size:1.4rem;font-weight:600;color:#e6edf3;margin-bottom:.25rem}
.subtitle{color:#7d8590;font-size:.85rem;margin-bottom:2rem}
.subtitle a{color:#7d8590;text-decoration:none}
.subtitle a:hover{text-decoration:underline}
h2{font-size:.8rem;font-weight:600;color:#7d8590;margin:1.75rem 0 .5rem;text-transform:uppercase;letter-spacing:.08em}
table{width:100%;border-collapse:collapse;background:#161b22;border:1px solid #30363d;border-radius:6px;overflow:hidden;margin-bottom:.25rem}
td{padding:.4rem .75rem;border-bottom:1px solid #21262d;font-size:.82rem;vertical-align:top;word-break:break-all}
td:first-child{color:#7d8590;white-space:nowrap;width:160px;font-weight:500}
td:last-child{color:#c9d1d9}
tr:last-child td{border-bottom:none}

/* IP Hero — repurposed for client-side inspector */
.ip-hero{text-align:center;padding:2rem 1.5rem;margin-bottom:.5rem;background:#161b22;border:1px solid #30363d;border-radius:8px}
.ip-label{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;color:#7d8590;margin-bottom:.75rem}
.ip-address{font-size:1.6rem;font-weight:700;color:#e6edf3;font-family:"SF Mono",SFMono-Regular,Consolas,"Liberation Mono",Menlo,monospace;letter-spacing:.02em;line-height:1.2}
.ip-meta{font-size:.85rem;color:#7d8590;margin-top:.6rem;display:flex;align-items:center;justify-content:center;gap:.5rem;flex-wrap:wrap}

/* Badges */
.badge{display:inline-block;padding:.15rem .45rem;border-radius:3px;font-size:.7rem;font-weight:500;letter-spacing:.02em}
.badge-green{background:#1a3a2a;color:#3fb950;border:1px solid #238636}
.badge-yellow{background:#3a2a1a;color:#d29922;border:1px solid #9e6a03}
.badge-red{background:#3a1a1a;color:#f85149;border:1px solid #da3633}
.badge-blue{background:#1a2a3a;color:#58a6ff;border:1px solid #1f6feb}
.badge-gray{background:#21262d;color:#7d8590;border:1px solid #30363d}
.badge-purple{background:#2a1a3a;color:#bc8cff;border:1px solid #8b5cf6}
.badges{display:inline-flex;gap:.3rem;flex-wrap:wrap}

/* Mono values */
.mono{font-family:"SF Mono",SFMono-Regular,Consolas,"Liberation Mono",Menlo,monospace;font-size:.8rem}
.mono-sm{font-size:.75rem}

/* Unavailable hint */
.unavailable{color:#484f58;font-style:italic;font-size:.8rem}

/* Section note */
.note{margin-top:1.75rem;padding:.75rem 1rem;background:#161b22;border:1px solid #30363d;border-radius:6px;font-size:.8rem;color:#7d8590;line-height:1.5}
.note strong{color:#c9d1d9;font-weight:600}

/* Footer */
footer{margin-top:2rem;color:#484f58;font-size:.75rem;text-align:center}
footer a{color:#484f58;text-decoration:none}
footer a:hover{color:#7d8590}

/* Responsive */
@media(max-width:480px){
  .ip-address{font-size:1.2rem}
  td:first-child{width:120px;font-size:.78rem}
  td:last-child{font-size:.78rem}
}
