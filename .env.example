### Tunnel Provider
# Host Cloudflare Tunnel identity + connector auth.
# Preferred: leave blank and run `ferry login` — it creates/selects a remotely-managed
# tunnel via the Cloudflare API and writes both values.
# Manual fallback: Dashboard → Zero Trust → Networks → Tunnels (UUID + token).
TUNNEL_ID=
TUNNEL_TOKEN=

### Optional: default domain for `ferry deploy` hostname prompts
# Used only as `<app>.$DOKKU_HOSTNAME` when you omit `-H/--hostname`.
# Not required for compose, healthchecks, or multi-domain hosts. Leave blank if you
# always pass explicit hostnames (or set per-app domains in Dokku).
# Example: example.com -> new apps default to <name>.example.com
DOKKU_HOSTNAME=

### Cloudflare API (auto-configured via `ferry login`)
# API token with:
#   Zone:DNS:Edit + Zone:Zone:Read
#   Account:Cloudflare Tunnel:Edit
# https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=

# Cloudflare account ID (auto-discovered from token)
CF_ACCOUNT_ID=
